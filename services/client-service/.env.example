# ============================================================================
# Client Service Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values
# ============================================================================

# Service Configuration
SERVICE_NAME=client-service
SERVICE_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/rawdrive
DATABASE_READ_REPLICA_URL=  # Optional read replica
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=50

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=30

# JWT Authentication (MUST match other services)
JWT_SECRET=your-secret-key-here-minimum-64-characters-for-production-use
JWT_ALGORITHM=HS256

# Rate Limiting
RATE_LIMIT_ENABLED=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://rawdrive.io

# Feature Flags
ENABLE_SMART_LISTS=true
ENABLE_DUPLICATE_DETECTION=true
ENABLE_VISITOR_CONVERSION=true
ENABLE_ANALYTICS=true
