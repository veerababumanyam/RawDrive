# ============================================================================
# Client CRM Microservice - Environment Variables
# ============================================================================
# Comprehensive client relationship management with gallery linking,
# activity tracking, visitor conversion, and KEDA autoscaling (2-20 replicas)
# ============================================================================

# =============================================================================
# Service Configuration
# =============================================================================
SERVICE_NAME=client-service
SERVICE_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
PORT=8011

# =============================================================================
# Database (PostgreSQL) - Shared with main backend
# =============================================================================
DATABASE_URL=postgresql://rawdrive:rawdrive@localhost:5432/rawdrive
DATABASE_READ_REPLICA_URL=  # Optional read replica for read-heavy operations
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=50
DB_COMMAND_TIMEOUT=60

# =============================================================================
# Redis - 3-tier caching strategy
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=30
REDIS_KEY_PREFIX=client:

# Cache TTLs (seconds)
CACHE_TTL_CLIENT_METADATA=300      # 5 min - L1 (client list, counts)
CACHE_TTL_CLIENT_DETAILS=120       # 2 min - L2 (full client details)
CACHE_TTL_ACTIVITY_TIMELINE=30     # 30 sec - L3 (activity timeline)
CACHE_TTL_SMART_LIST=180           # 3 min (smart list evaluation results)

# =============================================================================
# JWT Authentication (CRITICAL: MUST match backend)
# =============================================================================
JWT_SECRET=your-jwt-secret-key-minimum-64-characters-for-production-security
JWT_ALGORITHM=HS256

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://rawdrive.io

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_IMPORT=10/hour           # CSV imports
RATE_LIMIT_EXPORT=20/hour           # CSV exports
RATE_LIMIT_BULK_OPS=30/minute       # Bulk tag operations

# =============================================================================
# Import/Export Settings
# =============================================================================
IMPORT_MAX_FILE_SIZE_MB=10
IMPORT_MAX_RECORDS=10000
EXPORT_BATCH_SIZE=1000

# =============================================================================
# Duplicate Detection
# =============================================================================
DUPLICATE_SIMILARITY_THRESHOLD=0.85  # Fuzzy match threshold (0-1)
DUPLICATE_EMAIL_FUZZY_MATCH=true

# =============================================================================
# Storage (Cloudflare R2) - For client avatars
# =============================================================================
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=rawdrive

# =============================================================================
# Circuit Breaker (Redis graceful degradation)
# =============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# =============================================================================
# Metrics & Observability
# =============================================================================
METRICS_ENABLED=true
METRICS_CUSTOM_PREFIX=client

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_SMART_LISTS=true
ENABLE_DUPLICATE_DETECTION=true
ENABLE_VISITOR_CONVERSION=true
ENABLE_ANALYTICS=true
ENABLE_GALLERY_LINKING=true
ENABLE_COMMUNICATION_TRACKING=true
