{
  "name": "@rawdrive/photo-sync-service",
  "version": "1.0.0",
  "private": true,
  "description": "Photo import and synchronization microservice for RawDrive - imports photos from cloud providers (Google Photos, iCloud, Dropbox, Amazon Photos, OneDrive)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "lint": "eslint src/**/*.ts tests/**/*.ts --max-warnings 0",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:down": "tsx src/db/migrate.ts down",
    "docker:build": "docker build -t photo-sync-service .",
    "docker:run": "docker run -p 8007:8007 --env-file .env photo-sync-service"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-prometheus": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/instrumentation-fastify": "^0.42.0",
    "@opentelemetry/instrumentation-pg": "^0.48.0",
    "@opentelemetry/instrumentation-redis-4": "^0.44.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-metrics": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/sdk-trace-node": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "amqplib": "^0.10.5",
    "exifreader": "^4.23.5",
    "fastify": "^4.29.0",
    "google-auth-library": "^9.15.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.9",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.33.5",
    "uuid": "^11.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "rawdrive",
    "photo-sync",
    "photo-import",
    "google-photos",
    "icloud",
    "dropbox",
    "onedrive",
    "amazon-photos",
    "fastify",
    "microservice"
  ],
  "repository": {
    "type": "git",
    "directory": "services/photo-sync-service"
  },
  "license": "UNLICENSED"
}
