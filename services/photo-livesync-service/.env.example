# Photo Sync Service Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
SERVICE_NAME=photo-sync-service
SERVICE_VERSION=1.0.0
APP_ENV=development
HOST=0.0.0.0
PORT=8007

# Logging
LOG_LEVEL=info

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://rawdrive:rawdrive@localhost:5432/rawdrive
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=60000

# =============================================================================
# REDIS (Caching and distributed locks)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# RABBITMQ (Message queue for sync jobs)
# =============================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_HEARTBEAT_INTERVAL=60

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT secret (MUST match main backend's JWT configuration)
JWT_SECRET=your-64-byte-hex-secret-here-change-in-production
JWT_ALGORITHM=HS256

# AES-256-GCM encryption key for OAuth credentials at rest (min 32 characters)
ENCRYPTION_KEY=your-32-character-encryption-key!

# =============================================================================
# OAUTH SETTINGS
# =============================================================================
# Base URL for OAuth callbacks (used to construct redirect URIs)
OAUTH_CALLBACK_BASE_URL=http://localhost:8007
OAUTH_STATE_TTL_SECONDS=600

# -----------------------------------------------------------------------------
# Google Photos
# -----------------------------------------------------------------------------
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8007/api/v1/sync/oauth/google/callback

# -----------------------------------------------------------------------------
# Dropbox
# -----------------------------------------------------------------------------
# Obtain from: https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:8007/api/v1/sync/oauth/dropbox/callback

# -----------------------------------------------------------------------------
# OneDrive (Microsoft Graph)
# -----------------------------------------------------------------------------
# Obtain from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=http://localhost:8007/api/v1/sync/oauth/onedrive/callback
ONEDRIVE_TENANT_ID=common

# -----------------------------------------------------------------------------
# Amazon Photos
# -----------------------------------------------------------------------------
# Obtain from: https://developer.amazon.com/apps-and-games
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REDIRECT_URI=http://localhost:8007/api/v1/sync/oauth/amazon/callback

# -----------------------------------------------------------------------------
# iCloud (CloudKit Web Services)
# -----------------------------------------------------------------------------
# Obtain from: https://developer.apple.com/account/resources/
ICLOUD_APP_ID=
ICLOUD_API_TOKEN=
ICLOUD_ENVIRONMENT=development

# =============================================================================
# STORAGE (R2/S3-compatible)
# =============================================================================
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=rawdrive-photos
R2_REGION=auto
R2_SIGNED_URL_EXPIRY=3600

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# SYNC SETTINGS
# =============================================================================
# Number of photos to process per batch
SYNC_BATCH_SIZE=100
# Maximum retry attempts for failed operations
SYNC_MAX_RETRIES=5
# Base delay between retries (exponential backoff applied)
SYNC_RETRY_DELAY_MS=1000
# Number of concurrent photo downloads per worker
SYNC_CONCURRENT_DOWNLOADS=5
# How often to update sync progress (ms)
SYNC_PROGRESS_UPDATE_INTERVAL_MS=5000

# =============================================================================
# CIRCUIT BREAKER (Provider resilience)
# =============================================================================
# Number of failures before opening circuit
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Time to wait before attempting recovery (ms)
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_MS=30000
# Number of requests to allow in half-open state
CIRCUIT_BREAKER_HALF_OPEN_REQUESTS=3

# =============================================================================
# DUPLICATE DETECTION
# =============================================================================
DUPLICATE_DETECTION_ENABLED=true
# Hash algorithm for file deduplication: sha256 or md5
DUPLICATE_HASH_ALGORITHM=sha256

# =============================================================================
# GRACEFUL SHUTDOWN
# =============================================================================
# Time to wait for in-flight requests to complete (seconds)
DRAIN_TIMEOUT_SECONDS=30

# =============================================================================
# OBSERVABILITY & METRICS
# =============================================================================
METRICS_ENABLED=true
METRICS_PREFIX=photo_sync
# OpenTelemetry OTLP endpoint (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=photo-sync-service
