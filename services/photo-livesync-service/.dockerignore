# =============================================================================
# RawDrive Photo Sync Service - Docker Build Context Exclusions
# Optimizes build context size and prevents sensitive files from being included
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Node.js
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn
.pnp.*

# TypeScript build artifacts (rebuilt in Docker)
dist/
*.tsbuildinfo

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.editorconfig

# Environment files (sensitive!)
.env
.env.*
!.env.example

# Testing
coverage/
.nyc_output/
test-results/
*.lcov
.vitest-results/

# Documentation (not needed in image)
docs/
*.md
!README.md

# Development files
docker-compose*.yml
*.dockerfile
Dockerfile.*
Makefile

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
Jenkinsfile
.circleci/

# Kubernetes manifests (not needed in image)
k8s/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Test fixtures
tests/fixtures/large/
tests/fixtures/*.raw
tests/fixtures/*.cr2
tests/fixtures/*.nef
tests/fixtures/*.arw
tests/fixtures/*.jpg
tests/fixtures/*.jpeg
tests/fixtures/*.png

# Load test results
tests/load/results/

# Local development
*.local
*.local.*

# Secrets (never include!)
*.pem
*.key
*.crt
credentials.json
service-account.json

# Misc
*.bak
*.backup
