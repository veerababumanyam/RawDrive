# Upload Service Environment Variables
# Copy this file to .env and fill in the values

# Service Configuration
SERVICE_NAME=upload-service
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://rawdrive:rawdrive@localhost:5432/rawdrive

# Redis (for chunk buffering and rate limiting)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# Must match the main backend's JWT configuration
JWT_SECRET=your-64-byte-hex-secret-here
JWT_ALGORITHM=HS256
JWT_ISSUER=rawdrive
# Optional: Use EdDSA with public key (preferred for microservices)
# JWT_PUBLIC_KEY_PATH=/path/to/jwtEd25519.key.pub

# R2 Storage (Cloudflare R2 / S3-compatible)
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=rawdrive-uploads
R2_REGION=auto

# Encryption
# 32-byte hex key for file encryption (AES-256-CTR)
ENCRYPTION_KEY=your-32-byte-hex-key-here

# CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_WORKSPACE=500
RATE_LIMIT_WINDOW=60
MAX_CONCURRENT_UPLOADS_PER_WORKSPACE=10

# Upload Configuration
UPLOAD_SESSION_TTL_HOURS=24
MAX_CHUNK_SIZE_BYTES=10485760

# TUS Protocol
TUS_RESUMABLE_VERSION=1.0.0
TUS_MAX_SIZE=536870912
TUS_EXTENSIONS=creation,creation-with-upload,termination,checksum

# Storage Retry Configuration
STORAGE_RETRY_ATTEMPTS=5
STORAGE_RETRY_WAIT_MIN=1
STORAGE_RETRY_WAIT_MAX=30
STORAGE_RETRY_MULTIPLIER=2

# Kafka (optional - for asset processing events)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ASSET_PROCESSING=asset-processing
KAFKA_TOPIC_UPLOAD_COMPLETED=upload-completed
