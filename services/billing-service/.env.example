# Billing Microservice Environment Variables
# Copy this file to .env and fill in actual values

# Service Configuration
SERVICE_NAME=billing-service
SERVICE_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Database - Shared PostgreSQL
DATABASE_URL=postgresql://rawdrive:rawdrive@postgres:5432/rawdrive
DATABASE_READ_REPLICA_URL=
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=50
DB_COMMAND_TIMEOUT=60

# Redis - Caching and rate limiting
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_KEY_PREFIX=billing:

# JWT Authentication (MUST match backend)
JWT_SECRET=your-jwt-secret-here-64-byte-hex
JWT_ALGORITHM=HS256

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://rawdrive.io

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API=1000/minute
RATE_LIMIT_WEBHOOK=100/minute

# Razorpay Payment Provider
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=whsec_xxx

# Stripe Payment Provider (Optional)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_API_VERSION=2023-10-16

# Invoice Settings
INVOICE_PDF_STORAGE_PATH=workspaces/{workspace_id}/invoices/
GST_NUMBER=YOUR_GST_NUMBER
COMPANY_ADDRESS=Your Company Address
COMPANY_NAME=RawDrive
COMPANY_EMAIL=support@rawdrive.in
INVOICE_PREFIX=INV-

# Storage (R2) - For invoice PDFs
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=rawdrive

# Subscription Trial Defaults
TRIAL_DAYS=14
TRIAL_GRACE_PERIOD_DAYS=3

# Metrics and Monitoring
METRICS_ENABLED=true
METRICS_CUSTOM_PREFIX=billing

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
