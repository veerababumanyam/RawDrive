{
  "name": "rawdrive",
  "version": "0.0.2",
  "private": true,
  "description": "RawDrive — India's Premium Photography SaaS Platform",
  "author": "Manyam Prasad <manyamprasad@gmail.com>",
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "https://github.com/veerababumanyam/RawDriveCoBolt.git"
  },
  "workspaces": [
    "src/frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=src/frontend",
    "build": "npm run build --workspace=src/frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:frontend": "npm run test --workspace=src/frontend",
    "test:backend": "cd src/backend && go test ./... -count=1 -timeout 120s",
    "lint": "npm run lint --workspace=src/frontend",
    "version:check": "node -e \"console.log(require('./package.json').version)\""
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
