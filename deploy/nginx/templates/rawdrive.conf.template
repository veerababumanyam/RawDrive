# Site template — $PEER_NODE_IP is substituted via envsubst on container
# start. See deploy/docker-compose.prod-app.yml nginx service command.

# Upstream: backend API
# Primary is local container; backup is peer node's backend on its
# published port 8080 (peer-only UFW rule permits this).
upstream backend_upstream {
    zone backend_upstream 64k;
    server backend:8080 max_fails=2 fail_timeout=10s;
    server ${PEER_NODE_IP}:8080 backup max_fails=2 fail_timeout=10s;
    keepalive 32;
}

# Upstream: frontend (Next.js)
upstream frontend_upstream {
    zone frontend_upstream 64k;
    server frontend:3000 max_fails=2 fail_timeout=10s;
    server ${PEER_NODE_IP}:3000 backup max_fails=2 fail_timeout=10s;
    keepalive 16;
}

# HTTP → HTTPS redirect + ACME webroot challenge + container healthcheck
server {
    listen 80;
    listen [::]:80;
    server_name _;

    # Compose healthcheck endpoint — returns 200 directly without
    # redirecting to HTTPS. MUST come before the catch-all redirect.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    # ACME http-01 challenge (used once in Phase C and then during
    # renewal windows if we ever flip back from DNS-01)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Everything else: 301 to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# Main HTTPS server for rawdrive.in + www
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name rawdrive.in www.rawdrive.in;

    ssl_certificate     /etc/letsencrypt/wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/wildcard/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security headers (F-078). Kept aligned across apex/api/gallery blocks to
    # prevent drift; the apex additionally carries `preload` on HSTS plus the
    # COOP/COEP pair. The Next.js app emits the full per-request nonce CSP, so
    # nginx only adds non-conflicting document protections here.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "unsafe-none" always;
    add_header Cross-Origin-Embedder-Policy "unsafe-none" always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # www → apex redirect
    if ($host = www.rawdrive.in) {
        return 301 https://rawdrive.in$request_uri;
    }

    # Next.js static assets — served directly from a retained host-side store.
    #
    # During a rolling deploy, Cloudflare may fetch HTML from the already-updated
    # app node and then fetch the referenced CSS/JS from the peer node that has
    # not switched frontend containers yet. Keep old and new .next/static files
    # outside the frontend container and mount that store into nginx on both
    # nodes before either node starts serving new HTML.
    location /_next/static/ {
        root /srv/rawdrive-next-static;
        try_files $uri @next_static_not_found;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location @next_static_not_found {
        internal;
        default_type text/plain;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0, s-maxage=0" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        return 404 "not found\n";
    }

    # API proxied through the frontend origin (rawdrive.in/api/*) — backend
    location /api/ {
        limit_req zone=api_rate burst=200 nodelay;
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # /auth/* — backend mounts routes at BOTH /auth and /api/v1/auth
    # (see backend/cmd/api/main.go lines 486-487). The frontend's
    # next.config.ts rewrites() tries to proxy /auth/* to localhost:8080
    # which is the frontend container's own loopback — broken in prod.
    # Route /auth/* directly to backend here, bypassing frontend.
    location /auth/ {
        limit_req zone=auth_rate burst=10 nodelay;
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # /onboarding/*, /workspace/*, /team/* — same issue as /auth/*.
    # next.config.ts rewrites() proxies these to localhost:8080 which
    # doesn't exist in the frontend container. Route direct to backend.
    location ~ ^/(onboarding|workspace|team)/ {
        limit_req zone=api_rate burst=200 nodelay;
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # Auth endpoints get a tighter rate limit
    location ~ ^/api/v1/auth/(login|register|password/(forgot|reset)) {
        limit_req zone=auth_rate burst=10 nodelay;
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # Everything else: Next.js
    location / {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }
}

# api.rawdrive.in — dedicated subdomain for the backend
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.rawdrive.in;

    ssl_certificate     /etc/letsencrypt/wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/wildcard/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Security headers (F-078). The api subdomain serves only JSON/API
    # responses, so the CSP is locked down to default-src 'none' (no page
    # is ever meant to render here). HSTS omits `preload` — only valid on
    # the apex; subdomains inherit it via the apex includeSubDomains.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;

    location / {
        limit_req zone=api_rate burst=200 nodelay;
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }
}

# Deprecated tenant / gallery subdomains — *.rawdrive.in (single DNS label only).
# Exact-match server blocks above (rawdrive.in, www.rawdrive.in, api.rawdrive.in)
# take precedence over this regex match, so reserved labels are unaffected. The
# product no longer serves public gallery/studio URLs from wildcard workspace
# hosts; canonical gallery links are https://rawdrive.in/g/<slug>.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name "~^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.rawdrive\.in$";

    ssl_certificate     /etc/letsencrypt/wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/wildcard/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security headers (F-078). Keep parity even though this block now fails
    # closed, so deprecated hosts cannot become a weaker document context.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    return 410;
}
