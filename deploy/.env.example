# RawDrive production environment — EXAMPLE FILE
# =================================================
# The real file at /opt/rawdrive/app/.env is generated on each server during
# Phase B/C. It is NOT committed. This file documents the full schema.

# --- Postgres (rotated during Phase B, stored in DB-node .env only) ---
POSTGRES_USER=rawdrive
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=rawdrive
POSTGRES_REPLICATION_PASSWORD=<openssl rand -hex 24>

# --- Backup encryption (rotated during Phase B, stored in DB-node .env only) ---
# Used by /opt/rawdrive/backup-db.sh to symmetric-encrypt pg_dump output
# before upload to Backblaze B2 (object storage migrated R2 → B2 on
# 2026-05-18). Loss of this passphrase means the backups in B2 are
# unrecoverable — store a copy in your password manager.
BACKUP_GPG_PASSPHRASE=<openssl rand -hex 32>

# --- Backend connection (app nodes only) ---
# The app→pgbouncer leg is SAME-HOST, so it uses a Unix socket instead of
# TCP loopback. A Unix socket is not reachable over the network namespace,
# so plaintext SQL (JWTs/PII) on this leg cannot be sniffed by a sibling
# container or observed after a container escape — and TLS is N/A on a
# Unix socket, so sslmode is not specified here.
#   Map deploy/pgbouncer's unix_socket_dir into the app container and point
#   the host= param at it (default below: /var/run/pgbouncer).
# The CROSS-HOST pgbouncer→postgres leg is configured separately in
# pgbouncer/databases.ini and MUST use sslmode=require (TLS) since it
# crosses the wire to the DB node (.46).
DATABASE_URL=postgresql://rawdrive:<POSTGRES_PASSWORD>@/rawdrive?host=/var/run/pgbouncer&port=6432

# --- Valkey (rotated during Phase B) ---
VALKEY_PASSWORD=<openssl rand -hex 24>
VALKEY_URL=redis://:<VALKEY_PASSWORD>@187.127.142.46:6379

# --- Backblaze B2 object storage (S3-compatible API) — NOT rotated ---
# Object storage migrated R2 → B2 on 2026-05-18. The ONLY supported driver is
# "s3"; the storage factory fatals on any other value (including "r2").
#   B2_KEY_ID          maps to the S3 AccessKeyID
#   B2_APPLICATION_KEY maps to the S3 SecretAccessKey
STORAGE_DRIVER=s3
B2_BUCKET_NAME=rawfolder
B2_KEY_ID=<B2_KEY_ID>
B2_APPLICATION_KEY=<B2_APPLICATION_KEY>
B2_ENDPOINT=<B2_ENDPOINT>
B2_REGION=<B2_REGION>

# --- SMTP (from HostingerServerDetails.md — NOT rotated) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=noreply@rawdrive.de
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM=RawDrive <noreply@rawdrive.de>

# --- NATS ---
NATS_URL=nats://localhost:4222
NATS_NODE_NAME=nats-1   # nats-1 on .42, nats-2 on .44, nats-3 on .46
NATS_CLUSTER_SEED=<openssl rand -hex 16>
# F-036: client auth token. The Go API sends this via nats.Token; the NATS
# server must be configured with the SAME token (authorization { token: ... }).
# Ops action — set the real value in deploy/.env, never commit it.
NATS_AUTH_TOKEN=<openssl rand -hex 32>

# --- App config ---
JWT_SECRET=<openssl rand -hex 32>
APP_ENV=production
LOG_LEVEL=info
TZ=Asia/Kolkata
FRONTEND_URL=https://rawdrive.in
# F-008: source IPs trusted to set X-Forwarded-For for rate-limit keying.
# In the Hostinger topology the only hop in front of the API is the nginx
# container on the docker bridge, so 172.16.0.0/12 is the safe prod value;
# narrow it to the exact nginx subnet if known. Unset falls back to all
# RFC1918+loopback ranges with a boot warning.
TRUSTED_PROXY_CIDR=172.16.0.0/12

# --- Google OAuth ---
# The callback URL must exactly match the authorized redirect URI configured
# in Google Cloud Console.
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URL=https://api.rawdrive.in/auth/oauth/google/callback

# --- MoonShot (from HostingerServerDetails.md — NOT rotated) ---
MOONSHOT_API_KEY=<MOONSHOT_API_KEY>

# --- Platform settings KEK (envelope encryption per AGENTS.md F-005) ---
PLATFORM_SETTINGS_KEK=<openssl rand -hex 32>

# === Deploy-time vars (written to deploy/.env separately) ===
# These are NEVER overwritten by the tar push.
PEER_NODE_IP=187.127.142.44   # on .42; set to .42 on .44; unused on .46
