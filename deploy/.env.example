# RawDrive production environment — EXAMPLE FILE
# =================================================
# The real file at /opt/rawdrive/app/.env is generated on each server during
# Phase B/C. It is NOT committed. This file documents the full schema.

# --- Postgres (rotated during Phase B, stored in DB-node .env only) ---
POSTGRES_USER=rawdrive
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=rawdrive
POSTGRES_REPLICATION_PASSWORD=<openssl rand -hex 24>

# --- Backup encryption (rotated during Phase B, stored in DB-node .env only) ---
# Used by /opt/rawdrive/backup-db.sh to symmetric-encrypt pg_dump output
# before upload to Backblaze B2 (object storage migrated R2 → B2 on
# 2026-05-18). Loss of this passphrase means the backups in B2 are
# unrecoverable — store a copy in your password manager.
BACKUP_GPG_PASSPHRASE=<openssl rand -hex 32>
BACKUP_RCLONE_REMOTE=b2:rawdriveadminfiles

# --- Backend connection (app nodes only) ---
# The app→pgbouncer leg is SAME-HOST, so it uses a Unix socket instead of
# TCP loopback. A Unix socket is not reachable over the network namespace,
# so plaintext SQL (JWTs/PII) on this leg cannot be sniffed by a sibling
# container or observed after a container escape — and TLS is N/A on a
# Unix socket, so sslmode is not specified here.
#   Map deploy/pgbouncer's unix_socket_dir into the app container and point
#   the host= param at it (default below: /var/run/pgbouncer).
# The CROSS-HOST pgbouncer→postgres leg is configured separately in
# pgbouncer/databases.ini and MUST use sslmode=require (TLS) since it
# crosses the wire to the DB node (.46).
DATABASE_URL=postgresql://rawdrive:<POSTGRES_PASSWORD>@/rawdrive?host=/var/run/pgbouncer&port=6432

# --- Valkey (rotated during Phase B) ---
VALKEY_PASSWORD=<openssl rand -hex 24>
VALKEY_URL=redis://:<VALKEY_PASSWORD>@187.127.142.46:6379

# --- Backblaze B2 object storage (S3-compatible API) — NOT rotated ---
# Object storage migrated R2 → B2 on 2026-05-18. The ONLY supported driver is
# "s3"; the storage factory fatals on any other value (including "r2").
#   B2_KEY_ID          maps to the S3 AccessKeyID
#   B2_APPLICATION_KEY maps to the S3 SecretAccessKey
STORAGE_DRIVER=s3
# Managed media/client-photos bucket. Use a B2 application key SCOPED TO this
# bucket (rawdriveclientfiles) — separate from the backup bucket key below.
B2_BUCKET_NAME=rawdriveclientfiles
B2_KEY_ID=<B2_KEY_ID>
B2_APPLICATION_KEY=<B2_APPLICATION_KEY>
B2_ENDPOINT=<B2_ENDPOINT>
B2_REGION=<B2_REGION>

# --- Signed-CDN derivative delivery (cdn.rawdrive.in Cloudflare Worker) ---
# Flag-gated, default OFF. When CDN_SIGNED_URLS=true the backend emits
# short-lived HMAC-signed cdn.rawdrive.in URLs for gallery DERIVATIVES only
# (thumbnails/*, derivatives/*); originals/masters keep going through /storage.
# CDN_HMAC_SECRET MUST equal the Worker's secret. Activation = set these on both
# app nodes + re-sync platform_settings + roll backend. Rollback = set false +
# roll. See docs/runbooks/cdn-b2-signed-urls.md.
CDN_SIGNED_URLS=false
CDN_BASE_URL=https://cdn.rawdrive.in
CDN_HMAC_SECRET=<CDN_HMAC_SECRET>

# --- SMTP (SecureServer / GoDaddy-style SMTP for activation OTPs) ---
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USERNAME=noreply@rawdrive.in
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_SECURITY=ssl
SMTP_FROM=noreply@rawdrive.in
SMTP_FROM_NAME=RawDrive

# --- NATS ---
EVENT_BROKER=nats
NATS_URL=nats://nats:4222
NATS_NODE_NAME=nats-1   # nats-1 on .42, nats-2 on .44, nats-3 on .46
NATS_BIND_IP=187.127.142.42   # this node's peer IP; .44 on app node 2
NATS_CLUSTER_SEED=rdcluster_<openssl rand -hex 32>
# F-036: client auth token. The Go API sends this via nats.Token; the NATS
# server must be configured with the SAME token (authorization { token: ... }).
# Ops action — set the real value in deploy/.env, never commit it.
NATS_AUTH_TOKEN=rdauth_<openssl rand -hex 32>

# --- App config ---
JWT_SECRET=<openssl rand -hex 32>
APP_ENV=production
LOG_LEVEL=info
TZ=Asia/Kolkata
FRONTEND_URL=https://rawdrive.in
# F-008: source IPs trusted to set X-Forwarded-For for rate-limit keying.
# In the Hostinger topology the only hop in front of the API is the nginx
# container on the docker bridge, so 172.16.0.0/12 is the safe prod value;
# narrow it to the exact nginx subnet if known. Unset falls back to all
# RFC1918+loopback ranges with a boot warning.
TRUSTED_PROXY_CIDR=172.16.0.0/12

# --- Google OAuth ---
# The callback URL must exactly match the authorized redirect URI configured
# in Google Cloud Console.
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URL=https://api.rawdrive.in/auth/oauth/google/callback

# --- MoonShot (from HostingerServerDetails.md — NOT rotated) ---
MOONSHOT_API_KEY=<MOONSHOT_API_KEY>

# --- Platform settings KEK (envelope encryption per AGENTS.md F-005) ---
PLATFORM_SETTINGS_KEK=<openssl rand -hex 32>

# === Deploy-time vars (written to deploy/.env separately) ===
# These are NEVER overwritten by the tar push.
PEER_NODE_IP=187.127.142.44   # on .42; set to .42 on .44; unused on .46


# =============================================================================
# Deployment pipeline hardening (2026-06 — HA / PITR / registry / migration safety)
# =============================================================================
# Everything below is OPT-IN: with the var UNSET the deploy keeps its previous
# behavior exactly. Activate each capability deliberately per its runbook.
# Runbooks: docs/runbooks/pitr-restore.md, docs/runbooks/patroni-failover.md,
# docs/runbooks/cicd.md.

# --- Migration safety (read by the backend `migrate` runner) ---
# The runner now wraps each migration's DDL + bookkeeping in ONE transaction
# (except the 33 self-managed BEGIN;..COMMIT; migrations) and records a sha256
# of every applied migration for drift detection.
#   RAWDRIVE_MIGRATE_STRICT_CHECKSUM=1 -> a migration edited AFTER being applied
#     FAILS the deploy (default: warn). Enable once the baseline is clean — the
#     first run after this change baselines existing rows' checksums.
#   RAWDRIVE_MIGRATE_NO_TX_WRAP=1      -> escape hatch: disable the per-migration
#     transaction wrap (reverts to legacy autocommit). Leave UNSET in prod.
RAWDRIVE_MIGRATE_STRICT_CHECKSUM=0
# RAWDRIVE_MIGRATE_NO_TX_WRAP=1

# --- Deploy orchestration (read by deploy/scripts/deploy-prod.sh) ---
# `npm run deploy:prod` runs the FULL hardened pipeline BY DEFAULT — these
# capabilities are already ON in the script, so you do NOT need to set anything
# here. The lines below are OPT-OUT overrides; leave them COMMENTED to keep the
# full pipeline. (Setting one to 0 in your real .env would disable that phase.)
#   DEPLOY_PRE_MIGRATION_BACKUP (default 1) -> snapshot the DB before migrating
#     (pgBackRest incr if active, else logical pg_dump), but ONLY when this deploy
#     has pending migrations (code-only deploys skip it → fast). Fail-closed.
#     One-off skip without editing this file: `npm run deploy:prod -- --fast`.
#   DEPLOY_MIGRATE_STRICT (default 1) -> gate each node on /health/ready and fail
#     the deploy if a node is not at migration head.
#   DEPLOY_VERIFY_DB_NODE (default 1) -> verify the .46 DB node (postgres/valkey/
#     nats) + standby replication lag + backup freshness. Degrades to warnings if
#     .46 is unreachable. Needs SSH to ${DB_NODE_IP}.
#   DEPLOY_SMOKE_URL (default the public readiness probe) -> post-deploy GET;
#     informational only (never fails the deploy). Empty string disables it.
#   DEPLOY_REPLICA_LAG_MAX_BYTES (default 134217728 = 128MiB) -> standby-lag ceiling.
# Revert to the old minimal flow for one run: `npm run deploy:prod -- --minimal`.
#DEPLOY_PRE_MIGRATION_BACKUP=1
#DEPLOY_MIGRATE_STRICT=1
#DEPLOY_VERIFY_DB_NODE=1
#DEPLOY_SMOKE_URL=https://api.rawdrive.in/health/ready
#DEPLOY_REPLICA_LAG_MAX_BYTES=134217728
DB_NODE_IP=187.127.142.46

# --- Build-once image distribution via GHCR (read by deploy/scripts/deploy-prod.sh) ---
# DEPLOY_FROM_REGISTRY=1 -> pull prebuilt images from the registry by commit SHA
#   instead of building on each VPS (faster deploy, byte-identical images on both
#   nodes). Requires: the build-images CI workflow pushed the tag for this commit,
#   AND each node has run `docker login ghcr.io` with a read:packages token.
#   Default UNSET = build on each node (current behavior, no registry needed).
# DEPLOY_IMAGE_TAG -> override the tag to deploy. Default: the short commit SHA
#   being deployed (the CI workflow tags images :sha-<short> and :main).
#DEPLOY_FROM_REGISTRY=1
DEPLOY_IMAGE_REGISTRY=ghcr.io
DEPLOY_IMAGE_OWNER=manyamprasad
#DEPLOY_IMAGE_TAG=

# --- pgBackRest PITR repository (DB-node .46 .env ONLY; INERT until cutover) ---
# Physical incremental backups + WAL archiving for Point-In-Time-Recovery, with
# the repo on a SEPARATE Backblaze B2 bucket (rawdriveadminfiles) under /pgbackrest
# — distinct from the media bucket (rawdriveclientfiles). pgBackRest reads these as
# PGBACKREST_<OPTION>, so the committed deploy/pgbackrest/pgbackrest.conf holds
# NO secrets. Leave UNSET until the activation in docs/runbooks/pitr-restore.md
# §(a); archiving stays off and nothing references them until then.
#   PGBACKREST_REPO1_S3_KEY         → repo1-s3-key        (B2 S3 keyID for the BACKUP bucket)
#   PGBACKREST_REPO1_S3_KEY_SECRET  → repo1-s3-key-secret (B2 S3 applicationKey for the BACKUP bucket)
# Use a B2 application key SCOPED TO the rawdriveadminfiles bucket — do NOT reuse
# the media (rawdriveclientfiles) B2_KEY_ID/B2_APPLICATION_KEY, so a media-key leak can't
# touch backups and vice-versa.
PGBACKREST_REPO1_S3_KEY=<B2_BACKUP_KEY_ID>
PGBACKREST_REPO1_S3_KEY_SECRET=<B2_BACKUP_APPLICATION_KEY>
# Client-side repo encryption (aes-256-cbc). Like BACKUP_GPG_PASSPHRASE, this is
# the second lock so leaked B2 creds alone can't read a physical backup.
# LOSS = UNRECOVERABLE PHYSICAL BACKUPS — store a copy in your password manager.
PGBACKREST_REPO1_CIPHER_PASS=<openssl rand -hex 32>

# === Patroni automatic-failover subsystem (PLANNED CUTOVER — inert until activated) ===
# Set on each node with that node's OWN identity. See docs/runbooks/patroni-failover.md §7.
# Patroni member identity (DB-capable nodes .46 and .44 only; unset on .42)
PATRONI_NAME=pg-46              # "pg-46" on .46, "pg-44" on .44
PATRONI_NODE_IP=187.127.142.46  # this node's Postgres/REST IP (.46 / .44)
PATRONI_SCOPE=rawdrive          # cluster scope — SAME on every node
PATRONI_RESTAPI_PORT=8008       # Patroni REST API port (HAProxy health-checks this)
# etcd member identity (ALL THREE nodes .42/.44/.46)
ETCD_NAME=etcd-46               # "etcd-42"/"etcd-44"/"etcd-46" — unique per host
ETCD_NODE_IP=187.127.142.46     # this etcd member's IP (.42 / .44 / .46)
# etcd cluster roster — SAME three values on every node
ETCD_NODE_42_IP=187.127.142.42
ETCD_NODE_44_IP=187.127.142.44
ETCD_NODE_46_IP=187.127.142.46
ETCD_INITIAL_CLUSTER_TOKEN=rdetcd_<openssl rand -hex 32>  # binds the 3 into ONE cluster; secret
# Auth REUSES the existing rotated Postgres secrets above — no new passwords:
#   superuser/rewind  → POSTGRES_USER + POSTGRES_PASSWORD
#   replication       → replicator + POSTGRES_REPLICATION_PASSWORD
