# CoBolt managed
.env
.env.cobolt
.env.mcp
.env.backend
# Backup copies of env files (e.g. .env.cobolt.bak from pre-edit snapshots,
# or .env.bak.20260517-152221 from cobolt-managed rotations).
# These commonly contain real secrets and must never be committed.
# Two glob patterns to cover both `.env<...>.bak` and `.env.bak.<timestamp>`.
.env*.bak
.env*.bak.*
.env.bak*

# Editor / IDE state — per-user config, not project state.
# Committing these conflicts across devs who use different layouts.
.obsidian/
.vscode/
.idea/
.claude/
# Codex IDE per-user state — mirror the .claude/ exclusion so cobolt-sync
# install artifacts (.codex/agents/, .codex/cobolt/, .codex/skills/,
# .codex/.cobolt-backups/) stay out of the repo. .codex/config.toml is
# already tracked from before this entry; gitignore does not un-track.
.codex/
# Agent debug/verification screenshots (local-only, never product code).
.codex-artifacts/
# Cobolt-managed pre-edit backups (local-only).
.cobolt-backups/

_cobolt-output/
.worktrees/
_cobolt-docker/.env
node_modules/
dist/
.next/
build/
coverage/
*.log
.DS_Store
Thumbs.db
*.exe
node_modules/
_cobolt-output/stitch-screens/
test-results/
tests/photos/
.storage/
.tmp/
backend/.storage/
backend/api-fixed
backend/api-fixed~
*.exe~

# Playwright + E2E test artifacts
.playwright-mcp/
playwright-report/
e2e/e2e/
e2e/screenshots/
e2e/test-results/
tmp-backend*
tmp-*.exe

# Credential files — NEVER commit service account JSONs, OAuth client secrets,
# or any platform key material. Secrets MUST come from platform_settings
# or environment variables. See AGENTS.md "No Hardcoded Credentials".
gen-lang-client-*.json
*-client-secret*.json
*-credentials.json
*.serviceaccount.json
*service-account*.json
*oauth-client*.json
google-credentials*.json
firebase-adminsdk*.json
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# Production credentials file — untracked 2026-04-11 during prod bootstrap.
# Contains R2/SMTP/MoonShot/CF creds plus SSH key metadata. File stays on
# disk as operator reference but must never be committed.
HostingerServerDetails.md

# Local scratch env used during bootstrap (lives in /tmp/, but defensive)
rawdrive-secrets.env

# Screenshots — root-level captures stay on disk, not in repo
/*.png
/*.jpg
/*.jpeg

# Dev-machine symlinks to sibling CoBolt checkout — not part of this repo
/cli
/lib
/source
/tools
env
env.cobolt
