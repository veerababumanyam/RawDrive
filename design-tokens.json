    "shadows": {
        "_description": "Shadow tokens. 'glass' is the primary shadow for Liquid Glass surfaces. Never use raw Tailwind shadow primitives.",
        "sm": {
            "value": "0 1px 2px 0 hsla(0, 0%, 0%, 0.05)",
            "usage": "Subtle elevation (badges, tooltips)"
        },
        "md": {
            "value": "0 4px 6px -1px hsla(0, 0%, 0%, 0.07), 0 2px 4px -2px hsla(0, 0%, 0%, 0.05)",
            "usage": "Medium elevation (dropdowns)"
        },
        "glass": {
            "value": "0 8px 32px -4px hsla(0, 0%, 0%, 0.08), 0 4px 8px -2px hsla(0, 0%, 0%, 0.04)",
            "usage": "PRIMARY — glassmorphism cards, navbar, modals"
        },
        "lg": {
            "value": "0 10px 15px -3px hsla(0, 0%, 0%, 0.08), 0 4px 6px -4px hsla(0, 0%, 0%, 0.04)",
            "usage": "High elevation (popovers, floating panels)"
        },
        "xl": {
            "value": "0 20px 25px -5px hsla(0, 0%, 0%, 0.10), 0 8px 10px -6px hsla(0, 0%, 0%, 0.04)",
            "usage": "Max elevation (full modals, lightbox)"
        },
        "inner": {
            "value": "inset 0 2px 4px 0 hsla(0, 0%, 0%, 0.05)",
            "usage": "Sunken inputs, inset areas"
        }
