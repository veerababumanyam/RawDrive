# RawDrive Database Configuration
# This file contains optimal database connection settings for reliable restarts
# Source this file in all service containers

# PostgreSQL Connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rawdrive
POSTGRES_PASSWORD=rawdrive
POSTGRES_DB=rawdrive

# Connection Pool Settings (CRITICAL - same across all services)
# These settings prevent "too many clients" errors during restarts
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=15
DB_POOL_TIMEOUT=10
DB_COMMAND_TIMEOUT=30
DB_ECHO=false

# PgBouncer Connection Pool (if using PgBouncer)
PGBOUNCER_ENABLED=false
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction

# Redis Connection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Health Check Settings
HEALTH_CHECK_INTERVAL=10
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=30

# Service Startup Timeouts
SERVICE_STARTUP_TIMEOUT=60
DATABASE_INIT_TIMEOUT=30
CONNECTION_INIT_TIMEOUT=10

# Logging
LOG_LEVEL=INFO
DATABASE_LOG_LEVEL=WARNING
