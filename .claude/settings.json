{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(bun:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(pipenv:*)",
      "Bash(uvicorn:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(alembic:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(vite:*)",
      "Bash(tsc:*)",
      "Bash(ts-node:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(tailwindcss:*)",
      "Bash(electron:*)",
      "Bash(electron-builder:*)",
      "Bash(electron-rebuild:*)",
      "Bash(cmake:*)",
      "Bash(make:*)",
      "Bash(gcc:*)",
      "Bash(g++:*)",
      "Bash(clang:*)",
      "Bash(clang++:*)",
      "Bash(ninja:*)",
      "Bash(docker compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker logs:*)",
      "Bash(docker ps:*)",
      "Bash(docker inspect:*)",
      "Bash(gh:*)",
      "Bash(jq:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(agent-browser:*)",
      "WebFetch(domain:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker system prune:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(./secrets/**)",
      "Read(./**/credentials.json)"
    ],
    "additionalDirectories": [
      "../"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "docker",
      "git",
      "gh",
      "code"
    ],
    "filesystem": {
      "allowWrite": [
        "//tmp/build",
        "~/.claude",
        "~/.npm",
        "~/.pnpm-store",
        "~/.cache"
      ],
      "denyWrite": [
        "//etc",
        "//usr/local/bin",
        "~/.ssh",
        "~/.aws"
      ],
      "denyRead": [
        "~/.aws/credentials",
        "~/.ssh/id_rsa",
        "~/.ssh/id_ed25519"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "registry.npmmirror.com",
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org",
        "*.cloudflare.com",
        "*.r2.cloudflarestorage.com",
        "localhost",
        "127.0.0.1"
      ],
      "allowLocalBinding": true
    }
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".cache",
      ".venv"
    ],
    "sparsePaths": []
  },
  "attribution": {
    "commit": "Generated with Claude Code",
    "pr": "Generated with [Claude Code](https://claude.ai/code)"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/gsd-check-update.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/workspace-id-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/migration-safety.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/secret-detection.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/docker-health-check.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/gsd-context-monitor.js"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/test-coverage-gate.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/i18n-string-check.js"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/gsd-statusline.js",
    "padding": 2
  },
  "skipDangerousModePermissionPrompt": true
}
