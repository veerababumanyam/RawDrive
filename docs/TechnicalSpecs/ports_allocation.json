{
  "$schema": "./_schema.json",
  "specId": "ports_allocation",
  "title": "Service Ports Allocation",
  "version": "1.0.0",
  "lastUpdated": "2024-12-17",
  "status": "active",
  "description": "Canonical port assignments for all RawDrive services to prevent conflicts",
  "ports": {
    "infrastructure": {
      "postgresql": {
        "port": 5432,
        "protocol": "TCP",
        "service": "PostgreSQL + pgvector",
        "container": "rawdrive-postgres",
        "notes": "Standard PostgreSQL port"
      },
      "redis": {
        "port": 6379,
        "protocol": "TCP",
        "service": "Redis",
        "container": "rawdrive-redis",
        "notes": "Standard Redis port"
      },
      "loki": {
        "port": 3100,
        "protocol": "HTTP",
        "service": "Grafana Loki",
        "container": "rawdrive-loki",
        "notes": "Audit log aggregation - standard Loki port"
      },
      "grafana": {
        "port": 3000,
        "protocol": "HTTP",
        "service": "Grafana Dashboard",
        "container": "rawdrive-grafana",
        "notes": "Standard Grafana port - monitoring/visualization"
      }
    },
    "backend": {
      "fastapi": {
        "port": 8000,
        "protocol": "HTTP",
        "service": "FastAPI Backend",
        "container": "rawdrive-backend",
        "notes": "Main Python API server"
      },
      "gateway": {
        "port": 3002,
        "protocol": "HTTP",
        "service": "API Gateway (Node.js legacy)",
        "container": null,
        "notes": "Legacy Node.js gateway - will migrate to FastAPI"
      }
    },
    "frontend": {
      "vite_dev": {
        "port": 5173,
        "protocol": "HTTP",
        "service": "Vite Dev Server",
        "container": null,
        "notes": "Standard Vite dev port - React frontend"
      },
      "vite_preview": {
        "port": 4173,
        "protocol": "HTTP",
        "service": "Vite Preview Server",
        "container": null,
        "notes": "Standard Vite preview port"
      }
    },
    "microservices_legacy": {
      "auth": {
        "port": 3001,
        "protocol": "HTTP",
        "service": "Auth Service (legacy)",
        "notes": "Migrating to FastAPI backend"
      },
      "profile": {
        "port": 3003,
        "protocol": "HTTP",
        "service": "Profile Service (legacy)",
        "notes": "Migrating to FastAPI backend"
      },
      "tools": {
        "port": 3004,
        "protocol": "HTTP",
        "service": "Tools Service (legacy)",
        "notes": "Migrating to FastAPI backend"
      },
      "notification": {
        "port": 3005,
        "protocol": "HTTP",
        "service": "Notification Service (legacy)",
        "notes": "Migrating to FastAPI backend"
      },
      "analytics": {
        "port": 3006,
        "protocol": "HTTP",
        "service": "Analytics Service (legacy)",
        "notes": "Migrating to FastAPI backend"
      },
      "invitation": {
        "port": 3007,
        "protocol": "HTTP",
        "service": "Invitation Service (legacy)",
        "notes": "Migrating to FastAPI backend"
      },
      "worker": {
        "port": 3008,
        "protocol": "HTTP",
        "service": "Worker Service (legacy)",
        "notes": "Migrating to FastAPI backend"
      }
    },
    "reserved": {
      "description": "Ports reserved for future use or common conflicts to avoid",
      "ports": [
        { "port": 80, "reason": "HTTP standard - use for production reverse proxy only" },
        { "port": 443, "reason": "HTTPS standard - use for production reverse proxy only" },
        { "port": 8080, "reason": "Common alternative HTTP port - keep free" },
        { "port": 9090, "reason": "Prometheus default - reserve for metrics" },
        { "port": 9200, "reason": "Elasticsearch default - reserve for search" },
        { "port": 27017, "reason": "MongoDB default - not used but avoid" }
      ]
    }
  },
  "portRanges": {
    "infrastructure": "3000-3199, 5432, 6379",
    "backend_api": "8000-8099",
    "frontend": "4173, 5173",
    "legacy_microservices": "3001-3099 (being phased out)",
    "monitoring": "9000-9099"
  },
  "rules": [
    "NEVER change default ports for standard services (PostgreSQL 5432, Redis 6379, Grafana 3000, Loki 3100)",
    "Frontend uses Vite default 5173 for dev, 4173 for preview",
    "Backend FastAPI uses 8000 (standard uvicorn default)",
    "When adding new services, check this spec first for conflicts",
    "Update this spec when adding any new service port",
    "Legacy Node.js microservices in 3001-3008 range are being migrated"
  ],
  "dockerCompose": {
    "file": "infrastructure/docker/docker-compose.yml",
    "envFile": ".env"
  }
}
