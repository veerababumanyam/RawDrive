{
  "$schema": "./_schema.json",
  "specVersion": "1.0",
  "featureId": "ports_allocation",
  "name": "Service Ports Allocation",
  "status": "draft",
  "description": "Canonical port assignments for all RawDrive services to prevent conflicts",
  "ports": {
    "infrastructure": {
      "postgresql": {
        "port": 5432,
        "protocol": "TCP",
        "service": "PostgreSQL + pgvector",
        "container": "rawdrive-postgres",
        "notes": "Standard PostgreSQL port"
      },
      "redis": {
        "port": 6379,
        "protocol": "TCP",
        "service": "Redis",
        "container": "rawdrive-redis",
        "notes": "Standard Redis port"
      },
      "loki": {
        "port": 3100,
        "protocol": "HTTP",
        "service": "Grafana Loki",
        "container": "rawdrive-loki",
        "notes": "Audit log aggregation - standard Loki port"
      },
      "grafana": {
        "port": 3000,
        "protocol": "HTTP",
        "service": "Grafana Dashboard",
        "container": "rawdrive-grafana",
        "notes": "Standard Grafana port - monitoring/visualization"
      }
    },
    "microservices": {
      "backend": {
        "port": 8000,
        "protocol": "HTTP",
        "service": "Backend API",
        "container": "rawdrive-backend",
        "notes": "Main API, Core Features"
      },
      "gallery": {
        "port": 8004,
        "protocol": "HTTP",
        "service": "Gallery Service",
        "container": "rawdrive-gallery-service",
        "notes": "Viewing, Proofing, Magic Links"
      },
      "billing": {
        "port": 8005,
        "protocol": "HTTP",
        "service": "Billing Service",
        "container": "rawdrive-billing-service",
        "notes": "Subscriptions, Payments"
      },
      "onboarding": {
        "port": 8006,
        "protocol": "HTTP",
        "service": "Onboarding Service",
        "container": "rawdrive-onboarding-service",
        "notes": "User Registration"
      },
      "invitations": {
        "port": 8007,
        "protocol": "HTTP",
        "service": "Invitations API",
        "container": "rawdrive-invitations-api",
        "notes": "Digital Invitations"
      },
      "upload": {
        "port": 8008,
        "protocol": "HTTP",
        "service": "Upload Service",
        "container": "rawdrive-upload-service",
        "notes": "Bulk Asset Uploads (TUS)"
      },
      "notifications": {
        "port": 8010,
        "protocol": "HTTP",
        "service": "Notifications Service",
        "container": "rawdrive-notifications-service",
        "notes": "Transactional Comms"
      },
      "one_api": {
        "port": 3002,
        "protocol": "HTTP",
        "service": "One-API Dashboard",
        "container": "rawdrive-one-api",
        "notes": "AI Proxy Management"
      }
    },
    "reserved": {
      "description": "Ports reserved for future use or common conflicts to avoid",
      "ports": [
        {
          "port": 80,
          "reason": "HTTP standard - use for production reverse proxy only"
        },
        {
          "port": 443,
          "reason": "HTTPS standard - use for production reverse proxy only"
        },
        {
          "port": 8080,
          "reason": "Common alternative HTTP port - keep free"
        },
        {
          "port": 9090,
          "reason": "Prometheus default - reserve for metrics"
        },
        {
          "port": 9200,
          "reason": "Elasticsearch default - reserve for search"
        },
        {
          "port": 27017,
          "reason": "MongoDB default - not used but avoid"
        }
      ]
    }
  },
  "portRanges": {
    "microservices": "8000-8099",
    "infrastructure": "3000-3199, 5432, 6379, 6432",
    "frontend": "4173, 5173",
    "monitoring": "9000-9099"
  },
  "rules": [
    "NEVER change default ports for standard services (PostgreSQL 5432, Redis 6379, Grafana 3000, Loki 3100)",
    "Frontend uses Vite default 5173 for dev, 4173 for preview",
    "Backend FastAPI uses 8000 (standard uvicorn default)",
    "When adding new services, check this spec first for conflicts",
    "Update this spec when adding any new service port",
    "Legacy Node.js microservices in 3001-3008 range are being migrated"
  ],
  "lastUpdated": "2026-01-27",
  "tenancy": {
    "scopingKey": "workspace_id",
    "rules": [
      "Ports are assigned globally for the infrastructure but mapping is aware of multi-tenant service discovery."
    ]
  },
  "actors": [
    {
      "id": "system_admin",
      "name": "System Administrator",
      "description": "Manages infrastructure and port assignments."
    }
  ],
  "workflows": [
    {
      "id": "wf.port.allocation",
      "name": "Port Allocation Workflow",
      "steps": [
        "Check this spec for available ports.",
        "Assign new port to service.",
        "Update docker-compose.yml and .env."
      ]
    }
  ],
  "apis": [],
  "dataModel": {
    "entities": []
  },
  "security": {
    "controls": [
      "Ports for internal services (DB, Redis) are not exposed to the public internet.",
      "Access to metrics ports is restricted to localhost/internal network."
    ]
  },
  "observability": {
    "metrics": [
      "Traefik metrics on port 8082",
      "Prometheus metrics on port 9090"
    ]
  },
  "dockerCompose": {
    "file": "infrastructure/docker/docker-compose.yml",
    "envFile": ".env"
  }
}