{
  "$schema": "./_schema.json",
  "id": "face_detection_service",
  "title": "Face Detection and Identification Service",
  "version": "2.0.0",
  "status": "active",
  "owner": "platform-team",
  "description": "Comprehensive face detection, identification, and clustering service with dedicated microservice architecture for scalable processing",

  "architecture": {
    "overview": "Microservice-based face detection with dedicated worker process, multi-provider failover, embedding-based clustering, and admin-configurable settings",
    "deploymentModes": {
      "production": {
        "description": "Face worker runs as separate Docker container (recommended)",
        "mainBackend": "DISABLE_FACE_WORKER=true",
        "faceWorker": "Dockerfile.worker on port 8001"
      },
      "development": {
        "description": "Face worker embedded in main backend process (optional)",
        "mainBackend": "DISABLE_FACE_WORKER=false",
        "note": "Useful for single-process debugging"
      }
    },
    "components": [
      {
        "name": "FaceDetectionWorker",
        "type": "microservice",
        "description": "Dedicated microservice for processing face detection jobs. Runs as separate Docker container with its own resource limits.",
        "location": "backend/src/app/face_worker_main.py",
        "port": 8001,
        "healthEndpoints": ["/health", "/ready"],
        "dockerfile": "backend/Dockerfile.worker"
      },
      {
        "name": "FaceDetectionService",
        "type": "service",
        "description": "Core service orchestrating face detection, embedding generation, and clustering",
        "location": "backend/src/app/services/face_detection_service.py"
      },
      {
        "name": "FaceDetectionWorkerProcess",
        "type": "worker",
        "description": "Background worker processing face detection jobs from PostgreSQL queue",
        "location": "backend/src/app/services/face_detection_worker.py"
      },
      {
        "name": "ProviderManager",
        "type": "service",
        "description": "Manages AI provider selection, failover, and health monitoring with circuit breakers",
        "location": "backend/src/app/services/ai/providers/provider_manager.py"
      },
      {
        "name": "CloudVisionProvider",
        "type": "provider",
        "description": "Google Cloud Vision API integration for face detection (primary provider)",
        "location": "backend/src/app/services/ai/providers/cloud_vision_provider.py"
      },
      {
        "name": "GeminiProvider",
        "type": "provider",
        "description": "Google Gemini API integration for face detection (fallback)",
        "location": "backend/src/app/services/ai/providers/gemini_provider.py"
      },
      {
        "name": "LocalProvider",
        "type": "provider",
        "description": "OpenCV + MediaPipe local face detection (last resort, no API needed)",
        "location": "backend/src/app/services/ai/providers/local_provider.py"
      },
      {
        "name": "FaceClusterService",
        "type": "service",
        "description": "Manages face clustering, similarity matching, and group operations",
        "location": "backend/src/app/services/face_cluster_service.py"
      },
      {
        "name": "FaceRepository",
        "type": "repository",
        "description": "Data access for face records with pgvector embedding storage",
        "location": "backend/src/app/repositories/face_repository.py"
      },
      {
        "name": "FaceGroupRepository",
        "type": "repository",
        "description": "Data access for face groups/clusters",
        "location": "backend/src/app/repositories/face_group_repository.py"
      },
      {
        "name": "FaceConfigurationService",
        "type": "service",
        "description": "Manages admin-configurable settings for AI providers and detection parameters",
        "location": "backend/src/app/services/face_configuration_service.py"
      },
      {
        "name": "FaceAdminSettingsService",
        "type": "service",
        "description": "Admin interface for managing face detection settings",
        "location": "backend/src/app/services/face_admin_settings_service.py"
      }
    ],
    "dataFlow": [
      "1. Photo upload triggers face_detection job insertion into face_detection_jobs table",
      "2. Face Worker microservice polls face_detection_jobs for pending jobs",
      "3. Worker downloads and decrypts photo from R2 storage",
      "4. ProviderManager selects provider (Cloud Vision → Gemini → Local) with circuit breaker failover",
      "5. Provider returns face detections with bounding boxes (normalized to 0-100%)",
      "6. Worker generates 512-dim embeddings and stores in pgvector",
      "7. ClusterService auto-clusters faces if confidence >= clustering threshold",
      "8. Face thumbnails generated and uploaded to R2",
      "9. Job status updated to completed/failed",
      "10. Face groups become available through API"
    ],
    "queueSystem": {
      "type": "PostgreSQL polling",
      "table": "face_detection_jobs",
      "pollingInterval": "5 seconds",
      "batchSize": 10,
      "concurrency": 1,
      "note": "Uses PostgreSQL for simplicity; no Kafka/RabbitMQ required"
    }
  },

  "microservice": {
    "name": "face-worker",
    "description": "Dedicated microservice for CPU-intensive face detection processing",
    "dockerfile": "backend/Dockerfile.worker",
    "port": 8001,
    "healthCheck": {
      "endpoint": "/health",
      "interval": "10s",
      "timeout": "5s"
    },
    "resourceLimits": {
      "cpus": "1.0",
      "memory": "1G",
      "reservations": {
        "cpus": "0.25",
        "memory": "256M"
      }
    },
    "environmentVariables": [
      {
        "name": "DATABASE_URL",
        "description": "PostgreSQL connection string (shared with main backend)",
        "required": true
      },
      {
        "name": "REDIS_URL",
        "description": "Redis connection string (for caching)",
        "required": true
      },
      {
        "name": "DB_POOL_MIN_SIZE",
        "description": "Minimum database connections",
        "default": "1"
      },
      {
        "name": "DB_POOL_MAX_SIZE",
        "description": "Maximum database connections (conservative for face processing)",
        "default": "5"
      },
      {
        "name": "GOOGLE_APPLICATION_CREDENTIALS",
        "description": "Path to Google Cloud Vision service account JSON",
        "required": false
      }
    ],
    "dependencies": {
      "python": "3.11+",
      "packages": [
        "fastapi", "uvicorn", "asyncpg", "pydantic",
        "boto3 (S3/R2 storage)",
        "Pillow (image processing)",
        "opencv-python-headless (local detection)",
        "mediapipe (local face detection)",
        "google-cloud-vision (Cloud Vision API)",
        "google-generativeai (Gemini API)",
        "cryptography (encryption)"
      ]
    }
  },

  "providers": {
    "primary": {
      "name": "Google Cloud Vision",
      "type": "cloud_vision",
      "capabilities": ["face_detection", "face_landmarks", "emotions"],
      "configuration": {
        "credentialsSource": ["admin_settings", "env:GOOGLE_APPLICATION_CREDENTIALS"],
        "serviceAccountEmail": "rawdrivevision@docparser-468004.iam.gserviceaccount.com",
        "projectId": "docparser-468004",
        "rateLimitPerMinute": "configurable (default: 1800)",
        "timeoutMs": "configurable (default: 30000)"
      },
      "coordinateNormalization": "Pixel coordinates normalized to percentages (0-100) using PIL image dimensions",
      "responseFormat": {
        "faces": [
          {
            "boundingPoly": { "vertices": [{"x": 0, "y": 0}] },
            "fdBoundingPoly": { "vertices": [{"x": 0, "y": 0}] },
            "landmarks": [],
            "rollAngle": 0,
            "panAngle": 0,
            "tiltAngle": 0,
            "detectionConfidence": 0.95,
            "landmarkingConfidence": 0.85
          }
        ]
      }
    },
    "fallback": {
      "name": "Google Gemini",
      "type": "gemini",
      "capabilities": ["face_detection", "face_description"],
      "configuration": {
        "apiKeySource": ["admin_settings", "env:GEMINI_API_KEY"],
        "modelSource": ["admin_settings", "env:GEMINI_MODEL_FAST"],
        "availableModels": [
          "gemini-2.5-flash",
          "gemini-3-flash-preview",
          "gemini-3-pro-preview"
        ],
        "rateLimitPerMinute": "configurable (default: 60)",
        "timeoutMs": "configurable (default: 60000)"
      },
      "promptTemplate": "Analyze this image and detect all human faces. For each face, provide: 1) bounding box coordinates (x, y, width, height as percentages), 2) confidence score (0-1), 3) estimated age range, 4) any distinguishing features. Return as JSON array."
    },
    "lastResort": {
      "name": "Local Provider",
      "type": "local",
      "capabilities": ["face_detection"],
      "configuration": {
        "noApiRequired": true,
        "backend": "OpenCV + MediaPipe",
        "cpuOnly": true
      },
      "note": "Used when cloud providers are unavailable. No API costs but lower accuracy."
    }
  },

  "database": {
    "tables": [
      {
        "name": "faces",
        "description": "Stores detected faces with embeddings",
        "columns": [
          {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
          {"name": "workspace_id", "type": "UUID", "constraints": "NOT NULL REFERENCES workspaces(workspace_id)"},
          {"name": "photo_id", "type": "UUID", "constraints": "NOT NULL REFERENCES assets(asset_id)"},
          {"name": "face_group_id", "type": "UUID", "constraints": "REFERENCES face_groups(id)"},
          {"name": "bounding_box", "type": "JSONB", "constraints": "NOT NULL", "schema": {"x": "number (0-100%)", "y": "number (0-100%)", "width": "number (0-100%)", "height": "number (0-100%)"}},
          {"name": "confidence", "type": "DECIMAL(5,4)", "constraints": "NOT NULL"},
          {"name": "embedding", "type": "vector(512)", "constraints": ""},
          {"name": "provider", "type": "VARCHAR(50)", "constraints": "NOT NULL"},
          {"name": "detection_metadata", "type": "JSONB", "constraints": ""},
          {"name": "thumbnail_urls", "type": "JSONB", "constraints": "", "schema": {"small": "64px", "medium": "128px", "large": "256px"}},
          {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
          {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
        ],
        "indexes": [
          {"name": "idx_faces_workspace", "columns": ["workspace_id"]},
          {"name": "idx_faces_photo", "columns": ["photo_id"]},
          {"name": "idx_faces_group", "columns": ["face_group_id"]},
          {"name": "idx_faces_embedding", "type": "ivfflat", "columns": ["embedding"], "operator": "vector_cosine_ops"}
        ]
      },
      {
        "name": "face_groups",
        "description": "Stores face clusters/groups",
        "columns": [
          {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
          {"name": "workspace_id", "type": "UUID", "constraints": "NOT NULL REFERENCES workspaces(workspace_id)"},
          {"name": "name", "type": "VARCHAR(255)", "constraints": ""},
          {"name": "representative_face_id", "type": "UUID", "constraints": "REFERENCES faces(id)"},
          {"name": "centroid", "type": "vector(512)", "constraints": ""},
          {"name": "face_count", "type": "INTEGER", "constraints": "DEFAULT 0"},
          {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
          {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
        ],
        "indexes": [
          {"name": "idx_face_groups_workspace", "columns": ["workspace_id"]},
          {"name": "idx_face_groups_centroid", "type": "ivfflat", "columns": ["centroid"], "operator": "vector_cosine_ops"}
        ]
      },
      {
        "name": "ai_provider_settings",
        "description": "Admin-configurable AI provider settings",
        "columns": [
          {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
          {"name": "provider_name", "type": "VARCHAR(50)", "constraints": "NOT NULL UNIQUE"},
          {"name": "credentials_encrypted", "type": "BYTEA", "constraints": ""},
          {"name": "config", "type": "JSONB", "constraints": "NOT NULL DEFAULT '{}'"},
          {"name": "is_enabled", "type": "BOOLEAN", "constraints": "DEFAULT true"},
          {"name": "priority", "type": "INTEGER", "constraints": "DEFAULT 0"},
          {"name": "rate_limit_per_minute", "type": "INTEGER", "constraints": ""},
          {"name": "timeout_ms", "type": "INTEGER", "constraints": "DEFAULT 30000"},
          {"name": "health_status", "type": "VARCHAR(20)", "constraints": "DEFAULT 'unknown'"},
          {"name": "last_health_check", "type": "TIMESTAMPTZ", "constraints": ""},
          {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
          {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
        ]
      },
      {
        "name": "face_detection_jobs",
        "description": "Job queue for face detection processing (polled by face-worker microservice)",
        "columns": [
          {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
          {"name": "workspace_id", "type": "UUID", "constraints": "NOT NULL REFERENCES workspaces(workspace_id)"},
          {"name": "photo_id", "type": "UUID", "constraints": "NOT NULL UNIQUE REFERENCES assets(asset_id)"},
          {"name": "status", "type": "VARCHAR(20)", "constraints": "NOT NULL DEFAULT 'pending'", "values": ["pending", "processing", "completed", "failed"]},
          {"name": "provider_used", "type": "VARCHAR(50)", "constraints": ""},
          {"name": "faces_detected", "type": "INTEGER", "constraints": ""},
          {"name": "error_message", "type": "TEXT", "constraints": ""},
          {"name": "retry_count", "type": "INTEGER", "constraints": "DEFAULT 0"},
          {"name": "priority", "type": "INTEGER", "constraints": "DEFAULT 0", "note": "Higher = processed first. 0 for auto-upload, 10+ for manual re-scan"},
          {"name": "started_at", "type": "TIMESTAMPTZ", "constraints": ""},
          {"name": "completed_at", "type": "TIMESTAMPTZ", "constraints": ""},
          {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
        ],
        "indexes": [
          {"name": "idx_detection_jobs_status", "columns": ["status", "priority DESC", "created_at"]},
          {"name": "idx_detection_jobs_photo", "columns": ["photo_id"], "unique": true}
        ]
      }
    ]
  },

  "api": {
    "basePath": "/api/v1",
    "endpoints": [
      {
        "method": "GET",
        "path": "/galleries/{galleryId}/faces",
        "description": "List all detected faces in a gallery",
        "auth": "required",
        "file": "backend/src/app/api/v1/faces.py"
      },
      {
        "method": "GET",
        "path": "/faces/{faceId}",
        "description": "Get detailed face information",
        "auth": "required"
      },
      {
        "method": "POST",
        "path": "/faces/{faceId}/identify",
        "description": "Manually assign face to a group",
        "auth": "required"
      },
      {
        "method": "GET",
        "path": "/workspaces/{workspaceId}/face-groups",
        "description": "List all face groups in workspace",
        "auth": "required",
        "file": "backend/src/app/api/v1/face_groups.py"
      },
      {
        "method": "GET",
        "path": "/galleries/{galleryId}/face-groups",
        "description": "List face groups with gallery-specific statistics",
        "auth": "required"
      },
      {
        "method": "PUT",
        "path": "/face-groups/{groupId}",
        "description": "Update face group metadata (name, representative)",
        "auth": "required"
      },
      {
        "method": "DELETE",
        "path": "/face-groups/{groupId}",
        "description": "Delete face group (faces become ungrouped)",
        "auth": "required"
      },
      {
        "method": "POST",
        "path": "/face-groups/merge",
        "description": "Merge two face groups",
        "auth": "required"
      },
      {
        "method": "POST",
        "path": "/face-groups/{groupId}/split",
        "description": "Split faces from a group into new group",
        "auth": "required"
      },
      {
        "method": "POST",
        "path": "/photos/{photoId}/detect-faces",
        "description": "Trigger manual face detection (priority: 10+)",
        "auth": "required"
      },
      {
        "method": "GET",
        "path": "/admin/ai-providers",
        "description": "List AI provider configurations",
        "auth": "admin",
        "file": "backend/src/app/api/v1/admin_ai_providers.py"
      },
      {
        "method": "PUT",
        "path": "/admin/ai-providers/{providerId}",
        "description": "Update AI provider configuration",
        "auth": "admin"
      },
      {
        "method": "POST",
        "path": "/admin/ai-providers/{providerId}/test",
        "description": "Test AI provider connectivity",
        "auth": "admin"
      }
    ]
  },

  "configuration": {
    "workerSettings": {
      "DISABLE_FACE_WORKER": {
        "description": "Set to 'true' in main backend to use dedicated microservice (production)",
        "default": "false (embedded worker)",
        "production": "true"
      },
      "BATCH_SIZE": {
        "description": "Number of jobs to fetch per polling cycle",
        "default": 10
      },
      "POLL_INTERVAL": {
        "description": "Seconds between job queue polls",
        "default": 5
      },
      "CONCURRENT_JOBS": {
        "description": "Number of jobs processed concurrently (1 due to memory constraints)",
        "default": 1
      },
      "STALE_JOB_TIMEOUT_MINUTES": {
        "description": "Minutes before stuck processing jobs are reset",
        "default": 10
      }
    },
    "detectionSettings": {
      "face.similarity_threshold": {
        "type": "number",
        "default": 0.85,
        "min": 0.5,
        "max": 0.99,
        "description": "Minimum similarity score to consider faces as same person"
      },
      "face.min_confidence": {
        "type": "number",
        "default": 0.3,
        "min": 0.1,
        "max": 0.99,
        "description": "Minimum detection confidence to store a face"
      },
      "face.auto_cluster_threshold": {
        "type": "number",
        "default": 0.6,
        "description": "Minimum confidence for automatic clustering"
      },
      "face.max_retries": {
        "type": "number",
        "default": 3,
        "description": "Maximum retry attempts for failed detections"
      },
      "face.processing_enabled": {
        "type": "boolean",
        "default": true,
        "description": "Global toggle for face detection processing"
      }
    },
    "environmentVariables": [
      {
        "name": "GOOGLE_APPLICATION_CREDENTIALS",
        "description": "Path to Google Cloud Vision service account JSON file",
        "required": false,
        "example": "docs/docparser-468004-9b82008238af.json"
      },
      {
        "name": "GEMINI_API_KEY",
        "description": "Google Gemini API key",
        "required": false
      },
      {
        "name": "GEMINI_MODEL",
        "description": "Default Gemini model for face detection",
        "default": "gemini-3-flash-preview"
      }
    ]
  },

  "errorHandling": {
    "circuitBreaker": {
      "failureThreshold": 5,
      "recoveryTimeMs": 60000,
      "halfOpenRequests": 3,
      "location": "backend/src/app/services/ai/circuit_breaker.py"
    },
    "retryStrategy": {
      "maxRetries": 3,
      "backoffType": "exponential",
      "initialDelayMs": 60000,
      "formula": "delay = 60s × 2^attempt",
      "location": "backend/src/app/services/ai/retry_strategy.py"
    },
    "errorCodes": [
      {"code": "PROVIDER_UNAVAILABLE", "httpStatus": 503},
      {"code": "ALL_PROVIDERS_FAILED", "httpStatus": 503},
      {"code": "RATE_LIMIT_EXCEEDED", "httpStatus": 429},
      {"code": "INVALID_IMAGE_FORMAT", "httpStatus": 400},
      {"code": "FACE_GROUP_NOT_FOUND", "httpStatus": 404},
      {"code": "CROSS_WORKSPACE_ACCESS", "httpStatus": 403}
    ],
    "errorHandler": "backend/src/app/middleware/face_error_handler.py"
  },

  "security": {
    "dataIsolation": "All face queries filtered by workspace_id (multi-tenant)",
    "credentialStorage": "AES-256-GCM encryption for provider credentials",
    "auditLogging": "All face data access logged with user and workspace context",
    "apiAuth": "JWT authentication required for all endpoints",
    "adminAuth": "Platform admin role required for provider configuration"
  },

  "performance": {
    "targets": {
      "detectionLatency": "< 3 seconds per photo",
      "similaritySearch": "< 100ms for 10,000 faces",
      "batchThroughput": "100 photos per minute",
      "embeddingDimension": 512
    },
    "optimization": {
      "indexType": "IVFFlat for pgvector",
      "indexLists": 100,
      "probes": 10
    }
  },

  "monitoring": {
    "healthEndpoints": {
      "faceWorker": "http://face-worker:8001/health",
      "ready": "http://face-worker:8001/ready"
    },
    "metrics": [
      "face_detection_total",
      "face_detection_duration_seconds",
      "face_detection_errors_total",
      "provider_requests_total",
      "provider_latency_seconds",
      "face_clusters_total"
    ],
    "logging": {
      "destination": "Loki via structured logging",
      "contextFields": ["job_id", "photo_id", "workspace_id", "provider"]
    }
  },

  "relatedSpecs": [
    "people_face_recognition.json",
    "media_processing.json",
    "ai_platform_model_router.json"
  ]
}
