{
  "$schema": "./_schema.json",
  "id": "face_detection_service",
  "title": "Face Detection and Identification Service",
  "version": "1.0.0",
  "status": "draft",
  "owner": "platform-team",
  "description": "Comprehensive face detection, identification, and clustering service for organizing gallery photos by detected faces",
  
  "architecture": {
    "overview": "Multi-provider face detection service with automatic failover, embedding-based clustering, and admin-configurable settings",
    "components": [
      {
        "name": "FaceDetectionService",
        "type": "service",
        "description": "Core service orchestrating face detection, embedding generation, and clustering",
        "location": "backend/src/services/faceDetectionService.ts"
      },
      {
        "name": "ProviderManager",
        "type": "service",
        "description": "Manages AI provider selection, failover, and health monitoring",
        "location": "backend/src/services/ai/providerManager.ts"
      },
      {
        "name": "CloudVisionProvider",
        "type": "provider",
        "description": "Google Cloud Vision API integration for face detection",
        "location": "backend/src/services/ai/providers/cloudVisionProvider.ts"
      },
      {
        "name": "GeminiProvider",
        "type": "provider",
        "description": "Google Gemini API integration for face detection (fallback)",
        "location": "backend/src/services/ai/providers/geminiProvider.ts"
      },
      {
        "name": "FaceClusterService",
        "type": "service",
        "description": "Manages face clustering, similarity matching, and group operations",
        "location": "backend/src/services/faceClusterService.ts"
      },
      {
        "name": "FaceEmbeddingStore",
        "type": "repository",
        "description": "pgvector-based storage and search for face embeddings",
        "location": "backend/src/db/repositories/faceEmbeddingRepository.ts"
      },
      {
        "name": "FaceDetectionWorker",
        "type": "worker",
        "description": "Background worker for processing face detection jobs",
        "location": "backend/src/workers/faceDetectionWorker.ts"
      },
      {
        "name": "AdminSettingsService",
        "type": "service",
        "description": "Manages admin-configurable settings for AI providers",
        "location": "backend/src/services/adminSettingsService.ts"
      }
    ],
    "dataFlow": [
      "Photo upload triggers detection job queue",
      "Worker fetches photo and sends to ProviderManager",
      "ProviderManager selects provider based on priority and health",
      "Provider returns face detections with bounding boxes",
      "Service generates embeddings and stores in pgvector",
      "ClusterService matches faces to existing groups or creates new ones",
      "Face groups become available through API"
    ]
  },

  "providers": {
    "primary": {
      "name": "Google Cloud Vision",
      "type": "cloud_vision",
      "capabilities": ["face_detection", "face_landmarks", "emotions"],
      "configuration": {
        "credentialsSource": ["admin_settings", "env:GOOGLE_CLOUD_VISION_CREDENTIALS"],
        "serviceAccountEmail": "configurable",
        "projectId": "configurable",
        "rateLimitPerMinute": "configurable (default: 1800)",
        "timeoutMs": "configurable (default: 30000)"
      },
      "responseFormat": {
        "faces": [
          {
            "boundingPoly": { "vertices": [{"x": 0, "y": 0}] },
            "fdBoundingPoly": { "vertices": [{"x": 0, "y": 0}] },
            "landmarks": [],
            "rollAngle": 0,
            "panAngle": 0,
            "tiltAngle": 0,
            "detectionConfidence": 0.95,
            "landmarkingConfidence": 0.85
          }
        ]
      }
    },
    "fallback": {
      "name": "Google Gemini",
      "type": "gemini",
      "capabilities": ["face_detection", "face_description"],
      "configuration": {
        "apiKeySource": ["admin_settings", "env:GEMINI_API_KEY"],
        "modelSource": ["admin_settings", "env:GEMINI_MODEL_FAST"],
        "availableModels": [
          "gemini-2.5-flash",
          "gemini-3-flash-preview",
          "gemini-3-pro-preview"
        ],
        "rateLimitPerMinute": "configurable (default: 60)",
        "timeoutMs": "configurable (default: 60000)"
      },
      "promptTemplate": "Analyze this image and detect all human faces. For each face, provide: 1) bounding box coordinates (x, y, width, height as percentages), 2) confidence score (0-1), 3) estimated age range, 4) any distinguishing features. Return as JSON array."
    }
  },

  "database": {
    "tables": [
      {
        "name": "faces",
        "description": "Stores detected faces with embeddings",
        "columns": [
          {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
          {"name": "workspace_id", "type": "UUID", "constraints": "NOT NULL REFERENCES workspaces(id)"},
          {"name": "photo_id", "type": "UUID", "constraints": "NOT NULL REFERENCES photos(id)"},
          {"name": "face_group_id", "type": "UUID", "constraints": "REFERENCES face_groups(id)"},
          {"name": "bounding_box", "type": "JSONB", "constraints": "NOT NULL", "schema": {"x": "number", "y": "number", "width": "number", "height": "number"}},
          {"name": "confidence", "type": "DECIMAL(5,4)", "constraints": "NOT NULL"},
          {"name": "embedding", "type": "vector(512)", "constraints": ""},
          {"name": "provider", "type": "VARCHAR(50)", "constraints": "NOT NULL"},
          {"name": "detection_metadata", "type": "JSONB", "constraints": ""},
          {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
          {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
        ],
        "indexes": [
          {"name": "idx_faces_workspace", "columns": ["workspace_id"]},
          {"name": "idx_faces_photo", "columns": ["photo_id"]},
          {"name": "idx_faces_group", "columns": ["face_group_id"]},
          {"name": "idx_faces_embedding", "type": "ivfflat", "columns": ["embedding"], "operator": "vector_cosine_ops"}
        ]
      },
      {
        "name": "face_groups",
        "description": "Stores face clusters/groups",
        "columns": [
          {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
          {"name": "workspace_id", "type": "UUID", "constraints": "NOT NULL REFERENCES workspaces(id)"},
          {"name": "name", "type": "VARCHAR(255)", "constraints": ""},
          {"name": "representative_face_id", "type": "UUID", "constraints": "REFERENCES faces(id)"},
          {"name": "centroid", "type": "vector(512)", "constraints": ""},
          {"name": "face_count", "type": "INTEGER", "constraints": "DEFAULT 0"},
          {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
          {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
        ],
        "indexes": [
          {"name": "idx_face_groups_workspace", "columns": ["workspace_id"]},
          {"name": "idx_face_groups_centroid", "type": "ivfflat", "columns": ["centroid"], "operator": "vector_cosine_ops"}
        ]
      },
      {
        "name": "ai_provider_settings",
        "description": "Admin-configurable AI provider settings",
        "columns": [
          {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
          {"name": "provider_name", "type": "VARCHAR(50)", "constraints": "NOT NULL UNIQUE"},
          {"name": "credentials_encrypted", "type": "BYTEA", "constraints": ""},
          {"name": "config", "type": "JSONB", "constraints": "NOT NULL DEFAULT '{}'"},
          {"name": "is_enabled", "type": "BOOLEAN", "constraints": "DEFAULT true"},
          {"name": "priority", "type": "INTEGER", "constraints": "DEFAULT 0"},
          {"name": "rate_limit_per_minute", "type": "INTEGER", "constraints": ""},
          {"name": "timeout_ms", "type": "INTEGER", "constraints": "DEFAULT 30000"},
          {"name": "health_status", "type": "VARCHAR(20)", "constraints": "DEFAULT 'unknown'"},
          {"name": "last_health_check", "type": "TIMESTAMPTZ", "constraints": ""},
          {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
          {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
        ]
      },
      {
        "name": "face_detection_jobs",
        "description": "Tracks face detection job status",
        "columns": [
          {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
          {"name": "workspace_id", "type": "UUID", "constraints": "NOT NULL REFERENCES workspaces(id)"},
          {"name": "photo_id", "type": "UUID", "constraints": "NOT NULL REFERENCES photos(id)"},
          {"name": "status", "type": "VARCHAR(20)", "constraints": "NOT NULL DEFAULT 'pending'"},
          {"name": "provider_used", "type": "VARCHAR(50)", "constraints": ""},
          {"name": "faces_detected", "type": "INTEGER", "constraints": ""},
          {"name": "error_message", "type": "TEXT", "constraints": ""},
          {"name": "retry_count", "type": "INTEGER", "constraints": "DEFAULT 0"},
          {"name": "priority", "type": "INTEGER", "constraints": "DEFAULT 0"},
          {"name": "started_at", "type": "TIMESTAMPTZ", "constraints": ""},
          {"name": "completed_at", "type": "TIMESTAMPTZ", "constraints": ""},
          {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
        ],
        "indexes": [
          {"name": "idx_detection_jobs_status", "columns": ["status", "priority", "created_at"]},
          {"name": "idx_detection_jobs_photo", "columns": ["photo_id"]}
        ]
      }
    ],
    "migrations": [
      "001_enable_pgvector_extension.sql",
      "002_create_faces_table.sql",
      "003_create_face_groups_table.sql",
      "004_create_ai_provider_settings_table.sql",
      "005_create_face_detection_jobs_table.sql"
    ]
  },

  "api": {
    "basePath": "/api/v1",
    "endpoints": [
      {
        "method": "GET",
        "path": "/galleries/{galleryId}/faces",
        "description": "List all detected faces in a gallery",
        "auth": "required",
        "params": {
          "galleryId": "UUID"
        },
        "query": {
          "page": "number (default: 1)",
          "limit": "number (default: 50)",
          "minConfidence": "number (default: 0.7)",
          "faceGroupId": "UUID (optional filter)"
        },
        "response": {
          "faces": [
            {
              "id": "UUID",
              "photoId": "UUID",
              "faceGroupId": "UUID | null",
              "boundingBox": {"x": 0, "y": 0, "width": 0, "height": 0},
              "confidence": 0.95,
              "thumbnailUrl": "string"
            }
          ],
          "pagination": {"page": 1, "limit": 50, "total": 100}
        }
      },
      {
        "method": "GET",
        "path": "/faces/{faceId}",
        "description": "Get detailed face information",
        "auth": "required",
        "params": {
          "faceId": "UUID"
        },
        "response": {
          "id": "UUID",
          "photoId": "UUID",
          "faceGroupId": "UUID | null",
          "boundingBox": {"x": 0, "y": 0, "width": 0, "height": 0},
          "confidence": 0.95,
          "provider": "string",
          "detectionMetadata": {},
          "createdAt": "ISO8601"
        }
      },
      {
        "method": "POST",
        "path": "/faces/{faceId}/identify",
        "description": "Manually assign face to a group",
        "auth": "required",
        "params": {
          "faceId": "UUID"
        },
        "body": {
          "faceGroupId": "UUID"
        },
        "response": {
          "success": true,
          "face": {}
        }
      },
      {
        "method": "GET",
        "path": "/workspaces/{workspaceId}/face-groups",
        "description": "List all face groups in workspace",
        "auth": "required",
        "params": {
          "workspaceId": "UUID"
        },
        "query": {
          "page": "number",
          "limit": "number",
          "search": "string (name search)"
        },
        "response": {
          "faceGroups": [
            {
              "id": "UUID",
              "name": "string | null",
              "faceCount": 0,
              "representativeThumbnailUrl": "string",
              "createdAt": "ISO8601"
            }
          ],
          "pagination": {}
        }
      },
      {
        "method": "PUT",
        "path": "/face-groups/{groupId}",
        "description": "Update face group metadata",
        "auth": "required",
        "params": {
          "groupId": "UUID"
        },
        "body": {
          "name": "string (optional)",
          "representativeFaceId": "UUID (optional)"
        },
        "response": {
          "success": true,
          "faceGroup": {}
        }
      },
      {
        "method": "POST",
        "path": "/face-groups/merge",
        "description": "Merge two face groups",
        "auth": "required",
        "body": {
          "sourceGroupId": "UUID",
          "targetGroupId": "UUID"
        },
        "response": {
          "success": true,
          "mergedGroup": {}
        }
      },
      {
        "method": "POST",
        "path": "/face-groups/{groupId}/split",
        "description": "Split faces from a group into new group",
        "auth": "required",
        "params": {
          "groupId": "UUID"
        },
        "body": {
          "faceIds": ["UUID"]
        },
        "response": {
          "success": true,
          "newGroup": {}
        }
      },
      {
        "method": "POST",
        "path": "/photos/{photoId}/detect-faces",
        "description": "Trigger manual face detection",
        "auth": "required",
        "params": {
          "photoId": "UUID"
        },
        "body": {
          "priority": "number (optional, default: 10)"
        },
        "response": {
          "success": true,
          "jobId": "UUID"
        }
      },
      {
        "method": "GET",
        "path": "/admin/ai-providers",
        "description": "List AI provider configurations",
        "auth": "admin",
        "response": {
          "providers": [
            {
              "id": "UUID",
              "providerName": "string",
              "isEnabled": true,
              "priority": 0,
              "healthStatus": "healthy | unhealthy | unknown",
              "rateLimitPerMinute": 1800,
              "timeoutMs": 30000
            }
          ]
        }
      },
      {
        "method": "PUT",
        "path": "/admin/ai-providers/{providerId}",
        "description": "Update AI provider configuration",
        "auth": "admin",
        "params": {
          "providerId": "UUID"
        },
        "body": {
          "credentials": "object (encrypted)",
          "config": "object",
          "isEnabled": "boolean",
          "priority": "number",
          "rateLimitPerMinute": "number",
          "timeoutMs": "number"
        },
        "response": {
          "success": true,
          "provider": {}
        }
      },
      {
        "method": "POST",
        "path": "/admin/ai-providers/{providerId}/test",
        "description": "Test AI provider connectivity",
        "auth": "admin",
        "params": {
          "providerId": "UUID"
        },
        "response": {
          "success": true,
          "latencyMs": 250,
          "message": "string"
        }
      }
    ]
  },

  "configuration": {
    "adminSettings": {
      "description": "Settings configurable through admin interface",
      "settings": [
        {
          "key": "face.similarity_threshold",
          "type": "number",
          "default": 0.85,
          "min": 0.5,
          "max": 0.99,
          "description": "Minimum similarity score to consider faces as same person"
        },
        {
          "key": "face.min_confidence",
          "type": "number",
          "default": 0.7,
          "min": 0.1,
          "max": 0.99,
          "description": "Minimum detection confidence to process a face"
        },
        {
          "key": "face.batch_size",
          "type": "number",
          "default": 10,
          "min": 1,
          "max": 100,
          "description": "Number of photos to process in a single batch"
        },
        {
          "key": "face.max_retries",
          "type": "number",
          "default": 3,
          "min": 0,
          "max": 10,
          "description": "Maximum retry attempts for failed detections"
        },
        {
          "key": "face.processing_enabled",
          "type": "boolean",
          "default": true,
          "description": "Global toggle for face detection processing"
        }
      ]
    },
    "environmentVariables": {
      "description": "Fallback environment variables when admin settings not configured",
      "variables": [
        {
          "name": "GOOGLE_CLOUD_VISION_CREDENTIALS",
          "description": "Path to Google Cloud Vision service account JSON file",
          "required": false
        },
        {
          "name": "GEMINI_API_KEY",
          "description": "Google Gemini API key",
          "required": false
        },
        {
          "name": "GEMINI_MODEL",
          "description": "Default Gemini model for face detection",
          "default": "gemini-3-flash-preview"
        },
        {
          "name": "GEMINI_MODEL_FAST",
          "description": "Fast Gemini model for face detection",
          "default": "gemini-2.5-flash"
        },
        {
          "name": "FACE_SIMILARITY_THRESHOLD",
          "description": "Default similarity threshold",
          "default": "0.85"
        },
        {
          "name": "FACE_MIN_CONFIDENCE",
          "description": "Default minimum confidence",
          "default": "0.7"
        }
      ]
    }
  },

  "backgroundJobs": {
    "queue": "face-detection",
    "jobs": [
      {
        "name": "detectFaces",
        "description": "Process face detection for a single photo",
        "payload": {
          "photoId": "UUID",
          "workspaceId": "UUID",
          "priority": "number"
        },
        "retryStrategy": {
          "maxRetries": 3,
          "backoff": "exponential",
          "initialDelayMs": 1000
        }
      },
      {
        "name": "batchDetectFaces",
        "description": "Process face detection for multiple photos",
        "payload": {
          "photoIds": ["UUID"],
          "workspaceId": "UUID"
        }
      },
      {
        "name": "recalculateClusterCentroid",
        "description": "Recalculate centroid after cluster changes",
        "payload": {
          "faceGroupId": "UUID"
        }
      },
      {
        "name": "providerHealthCheck",
        "description": "Periodic health check for AI providers",
        "schedule": "*/5 * * * *",
        "payload": {}
      }
    ]
  },

  "errorHandling": {
    "circuitBreaker": {
      "failureThreshold": 5,
      "recoveryTimeMs": 60000,
      "halfOpenRequests": 3
    },
    "errorCodes": [
      {
        "code": "FACE_DETECTION_FAILED",
        "httpStatus": 500,
        "message": "Face detection failed after all provider attempts"
      },
      {
        "code": "PROVIDER_UNAVAILABLE",
        "httpStatus": 503,
        "message": "All AI providers are currently unavailable"
      },
      {
        "code": "RATE_LIMIT_EXCEEDED",
        "httpStatus": 429,
        "message": "Provider rate limit exceeded, request queued for retry"
      },
      {
        "code": "INVALID_IMAGE_FORMAT",
        "httpStatus": 400,
        "message": "Image format not supported for face detection"
      },
      {
        "code": "FACE_GROUP_NOT_FOUND",
        "httpStatus": 404,
        "message": "Face group not found"
      },
      {
        "code": "CROSS_WORKSPACE_ACCESS",
        "httpStatus": 403,
        "message": "Cannot access face data from another workspace"
      }
    ]
  },

  "security": {
    "dataIsolation": "All face queries filtered by workspace_id",
    "credentialStorage": "AES-256-GCM encryption for provider credentials",
    "auditLogging": "All face data access logged with user and workspace context",
    "apiAuth": "JWT authentication required for all endpoints",
    "adminAuth": "Platform admin role required for provider configuration"
  },

  "performance": {
    "targets": {
      "detectionLatency": "< 3 seconds per photo",
      "similaritySearch": "< 100ms for 10,000 faces",
      "batchThroughput": "100 photos per minute",
      "embeddingDimension": 512
    },
    "optimization": {
      "indexType": "IVFFlat for pgvector",
      "indexLists": 100,
      "probes": 10
    }
  },

  "monitoring": {
    "metrics": [
      "face_detection_total",
      "face_detection_duration_seconds",
      "face_detection_errors_total",
      "provider_requests_total",
      "provider_latency_seconds",
      "face_clusters_total",
      "similarity_search_duration_seconds"
    ],
    "alerts": [
      {
        "name": "HighDetectionErrorRate",
        "condition": "rate(face_detection_errors_total[5m]) > 0.1",
        "severity": "warning"
      },
      {
        "name": "AllProvidersUnhealthy",
        "condition": "sum(provider_health_status) == 0",
        "severity": "critical"
      }
    ]
  },

  "relatedSpecs": [
    "people_face_recognition.json",
    "media_processing.json",
    "ai_platform_model_router.json"
  ]
}
