{
  "$schema": "./_schema.json",
  "specVersion": "1.0",
  "featureId": "galleries_client_portal",
  "name": "Galleries, Client Portal, and Sharing",
  "status": "draft",
  "lastUpdated": "2025-01-27",
  "sourceDocs": [
    "docs/Features/GalleryFeatures.md",
    "docs/Features/CLIENT_FACING_FEATURES.md",
    "docs/Features/PRD.md"
  ],
  "description": "Gallery creation, organization, and a client-facing portal to view, filter, favorite/select, comment, and download assets based on access policies and plan.",
  "goals": [
    "Provide a branded client portal with fast browsing and mobile-first UX.",
    "Support proofing workflows (favorites, selections, comments).",
    "Enable controlled access via Share Links, passwords, expiry, and per-action permissions.",
    "Respect i18n preferences in client portal, including Urdu RTL."
  ],
  "tenancy": {
    "scopingKey": "workspace_id",
    "rules": [
      "Galleries are always workspace-scoped.",
      "Client portal requests must resolve access via share link tokens or authenticated members.",
      "Asset visibility is determined by gallery membership + asset state (not deleted)."
    ]
  },
  "actors": [
    {
      "id": "staff_user",
      "name": "Staff User",
      "description": "Creates galleries, publishes to clients."
    },
    {
      "id": "client_viewer",
      "name": "Client (Share Link)",
      "description": "Views and interacts with galleries."
    },
    {
      "id": "workspace_admin",
      "name": "Workspace Admin",
      "description": "Configures branding, portal defaults."
    }
  ],
  "fieldClassification": {
    "legend": {
      "MANDATORY": "Required field, must always have a value",
      "OPTIONAL": "Field may be null/undefined",
      "COMPUTED": "Derived from other data, not stored directly",
      "SYSTEM": "Auto-generated by the system (timestamps, IDs)"
    }
  },
  "dataModel": {
    "entities": [
      {
        "name": "Gallery",
        "table": "galleries",
        "primaryKey": "gallery_id",
        "workspaceScoped": true,
        "fields": [
          {
            "name": "gallery_id",
            "type": "uuid",
            "classification": "SYSTEM",
            "notes": "Primary key, auto-generated"
          },
          {
            "name": "workspace_id",
            "type": "uuid",
            "classification": "SYSTEM",
            "notes": "Tenant isolation key"
          },
          {
            "name": "title",
            "type": "string",
            "classification": "MANDATORY",
            "constraints": {
              "minLength": 1,
              "maxLength": 255
            }
          },
          {
            "name": "description",
            "type": "string",
            "nullable": true,
            "classification": "OPTIONAL",
            "constraints": {
              "maxLength": 1000
            }
          },
          {
            "name": "client_name",
            "type": "string",
            "nullable": true,
            "classification": "OPTIONAL",
            "constraints": {
              "maxLength": 255
            },
            "notes": "Display name for client in header"
          },
          {
            "name": "status",
            "type": "enum(draft,published,archived)",
            "classification": "MANDATORY",
            "default": "draft"
          },
          {
            "name": "branding_profile_id",
            "type": "uuid",
            "nullable": true,
            "classification": "OPTIONAL",
            "notes": "Reference to workspace branding preset"
          },
          {
            "name": "portal_language",
            "type": "string",
            "nullable": true,
            "classification": "OPTIONAL",
            "notes": "ISO language code (e.g., en-IN, hi-IN)"
          },
          {
            "name": "layout_style",
            "type": "enum(tabs,continuous)",
            "nullable": true,
            "classification": "OPTIONAL",
            "default": "tabs"
          },
          {
            "name": "theme",
            "type": "enum(light,dark,system)",
            "nullable": true,
            "classification": "OPTIONAL",
            "default": "system"
          },
          {
            "name": "download_policy",
            "type": "enum(view_only,web_only,original_allowed,watermarked_only)",
            "nullable": true,
            "classification": "OPTIONAL",
            "default": "view_only"
          },
          {
            "name": "exif_visible",
            "type": "boolean",
            "nullable": true,
            "classification": "OPTIONAL",
            "default": false
          },
          {
            "name": "password_hash",
            "type": "string",
            "nullable": true,
            "classification": "OPTIONAL",
            "notes": "bcrypt hash if password protected"
          },
          {
            "name": "email_registration_required",
            "type": "boolean",
            "nullable": true,
            "classification": "OPTIONAL",
            "default": false
          },
          {
            "name": "expires_at",
            "type": "timestamp",
            "nullable": true,
            "classification": "OPTIONAL",
            "notes": "ISO timestamp for auto-expiry"
          },
          {
            "name": "custom_domain",
            "type": "string",
            "nullable": true,
            "classification": "OPTIONAL",
            "notes": "Tier-gated feature"
          },
          {
            "name": "cover_asset_id",
            "type": "uuid",
            "nullable": true,
            "classification": "OPTIONAL",
            "notes": "Reference to cover photo asset"
          },
          {
            "name": "created_by_user_id",
            "type": "uuid",
            "classification": "MANDATORY",
            "notes": "User who created the gallery"
          },
          {
            "name": "published_at",
            "type": "timestamp",
            "nullable": true,
            "classification": "OPTIONAL",
            "notes": "Set when status changes to published"
          },
          {
            "name": "created_at",
            "type": "timestamp",
            "classification": "SYSTEM"
          }
        ],
        "indexes": [
          "galleries_ws_status_idx",
          "galleries_ws_created_idx"
        ],
        "computedFields": [
          {
            "name": "photo_count",
            "type": "number",
            "notes": "Count of gallery_assets"
          },
          {
            "name": "video_count",
            "type": "number",
            "notes": "Count of video assets"
          },
          {
            "name": "favorites_count",
            "type": "number",
            "notes": "Count from selection_items where favorite=true"
          },
          {
            "name": "selections_count",
            "type": "number",
            "notes": "Count from selection_items"
          },
          {
            "name": "password_protected",
            "type": "boolean",
            "notes": "True if password_hash is not null"
          },
          {
            "name": "cover_image_url",
            "type": "string",
            "notes": "CDN URL from cover_asset_id or first asset"
          }
        ]
      },
      {
        "name": "SubGallery",
        "table": "sub_galleries",
        "primaryKey": "sub_gallery_id",
        "workspaceScoped": true,
        "fields": [
          {
            "name": "sub_gallery_id",
            "type": "uuid",
            "classification": "SYSTEM",
            "notes": "Primary key, auto-generated"
          },
          {
            "name": "workspace_id",
            "type": "uuid",
            "classification": "SYSTEM",
            "notes": "Tenant isolation key"
          },
          {
            "name": "gallery_id",
            "type": "uuid",
            "classification": "MANDATORY",
            "notes": "Parent gallery reference"
          },
          {
            "name": "name",
            "type": "string",
            "classification": "MANDATORY",
            "constraints": {
              "minLength": 1,
              "maxLength": 100
            },
            "notes": "Unique within gallery"
          },
          {
            "name": "sort_order",
            "type": "number",
            "classification": "MANDATORY",
            "default": 0,
            "notes": "Integer for ordering tabs"
          },
          {
            "name": "visible",
            "type": "boolean",
            "classification": "MANDATORY",
            "default": true,
            "notes": "Controls visibility in client portal"
          },
          {
            "name": "cover_asset_id",
            "type": "uuid",
            "nullable": true,
            "classification": "OPTIONAL",
            "notes": "Reference to cover photo"
          },
          {
            "name": "created_at",
            "type": "timestamp",
            "classification": "SYSTEM"
          }
        ],
        "indexes": [
          "sub_galleries_ws_gallery_order_idx",
          "sub_galleries_ws_gallery_name_unique"
        ],
        "computedFields": [
          {
            "name": "photo_count",
            "type": "number",
            "notes": "Count of gallery_assets in this sub-gallery"
          },
          {
            "name": "cover_image_url",
            "type": "string",
            "notes": "CDN URL from cover_asset_id or first asset"
          }
        ]
      },
      {
        "name": "GalleryAsset",
        "table": "gallery_assets",
        "primaryKey": "gallery_asset_id",
        "workspaceScoped": true,
        "fields": [
          {
            "name": "gallery_asset_id",
            "type": "uuid",
            "classification": "SYSTEM",
            "notes": "Primary key, auto-generated"
          },
          {
            "name": "workspace_id",
            "type": "uuid",
            "classification": "SYSTEM",
            "notes": "Tenant isolation key"
          },
          {
            "name": "gallery_id",
            "type": "uuid",
            "classification": "MANDATORY",
            "notes": "Parent gallery reference"
          },
          {
            "name": "sub_gallery_id",
            "type": "uuid",
            "nullable": true,
            "classification": "OPTIONAL",
            "notes": "null = Root Gallery (unassigned)"
          },
          {
            "name": "asset_id",
            "type": "uuid",
            "classification": "MANDATORY",
            "notes": "Reference to assets table"
          },
          {
            "name": "sort_order",
            "type": "number",
            "classification": "MANDATORY",
            "default": 0,
            "notes": "Integer for ordering within gallery/sub-gallery"
          },
          {
            "name": "visible",
            "type": "boolean",
            "classification": "MANDATORY",
            "default": true,
            "notes": "Controls visibility in client portal"
          },
          {
            "name": "is_private",
            "type": "boolean",
            "classification": "MANDATORY",
            "default": false,
            "notes": "Per-asset lock (requires access code to view)"
          },
          {
            "name": "access_code_hash",
            "type": "string",
            "nullable": true,
            "classification": "OPTIONAL",
            "notes": "bcrypt hash for private photo access code"
          },
          {
            "name": "created_at",
            "type": "timestamp",
            "classification": "SYSTEM"
          }
        ],
        "indexes": [
          "gallery_assets_ws_gallery_idx",
          "gallery_assets_ws_asset_idx",
          "gallery_assets_ws_gallery_asset_unique"
        ],
        "computedFields": [
          {
            "name": "is_favorited",
            "type": "boolean",
            "notes": "True if any selection_item has favorite=true for this asset"
          },
          {
            "name": "is_selected",
            "type": "boolean",
            "notes": "True if any selection_item exists for this asset"
          },
          {
            "name": "favorites_count",
            "type": "number",
            "notes": "Count of selection_items with favorite=true"
          }
        ]
      },
      {
        "name": "ClientInteraction",
        "table": "client_interactions",
        "primaryKey": "interaction_id",
        "workspaceScoped": true,
        "fields": [
          {
            "name": "interaction_id",
            "type": "uuid"
          },
          {
            "name": "workspace_id",
            "type": "uuid"
          },
          {
            "name": "gallery_id",
            "type": "uuid"
          },
          {
            "name": "asset_id",
            "type": "uuid",
            "nullable": true
          },
          {
            "name": "type",
            "type": "enum(view,favorite,select,comment,download)"
          },
          {
            "name": "actor",
            "type": "json",
            "notes": "share_link_id or client profile"
          },
          {
            "name": "payload",
            "type": "json",
            "nullable": true
          },
          {
            "name": "created_at",
            "type": "timestamp"
          }
        ],
        "indexes": [
          "client_interactions_ws_gallery_time_idx",
          "client_interactions_ws_asset_time_idx"
        ]
      }
    ]
  },
  "apis": [
    {
      "id": "galleries.list",
      "method": "GET",
      "path": "/api/v1/workspaces/{workspace_id}/galleries",
      "auth": "user_jwt",
      "rateLimit": "standard",
      "request": {
        "query": {
          "page": "integer?",
          "limit": "integer?",
          "sort": "string?",
          "status": "string?"
        }
      },
      "response": {
        "body": {
          "galleries": "array",
          "meta": {
            "total": "integer",
            "page": "integer",
            "limit": "integer"
          }
        }
      },
      "errors": [
        "FORBIDDEN",
        "NOT_FOUND"
      ],
      "implementationStatus": "implemented"
    },
    {
      "id": "galleries.create",
      "method": "POST",
      "path": "/api/v1/workspaces/{workspace_id}/galleries",
      "auth": "user_jwt",
      "rateLimit": "standard",
      "request": {
        "body": {
          "title": "string",
          "description": "string?",
          "client_name": "string?"
        }
      },
      "response": {
        "body": {
          "gallery_id": "uuid",
          "title": "string",
          "status": "draft",
          "created_at": "timestamp"
        }
      },
      "errors": [
        "FORBIDDEN",
        "VALIDATION_ERROR"
      ],
      "implementationStatus": "implemented"
    },
    {
      "id": "galleries.get",
      "method": "GET",
      "path": "/api/v1/workspaces/{workspace_id}/galleries/{gallery_id}",
      "auth": "user_jwt",
      "rateLimit": "standard",
      "response": {
        "body": {
          "gallery_id": "uuid",
          "title": "string",
          "description": "string?",
          "client_name": "string?",
          "status": "enum",
          "sub_galleries": "array",
          "stats": "object"
        }
      },
      "errors": [
        "FORBIDDEN",
        "NOT_FOUND"
      ],
      "implementationStatus": "implemented"
    },
    {
      "id": "galleries.update",
      "method": "PATCH",
      "path": "/api/v1/workspaces/{workspace_id}/galleries/{gallery_id}",
      "auth": "user_jwt",
      "rateLimit": "standard",
      "request": {
        "body": {
          "title": "string?",
          "description": "string?",
          "client_name": "string?",
          "password": "string?",
          "remove_password": "boolean?"
        }
      },
      "response": {
        "body": {
          "gallery_id": "uuid",
          "title": "string",
          "status": "enum"
        }
      },
      "errors": [
        "FORBIDDEN",
        "NOT_FOUND",
        "VALIDATION_ERROR"
      ],
      "implementationStatus": "implemented",
      "notes": "Password hashing placeholder - needs bcrypt implementation"
    },
    {
      "id": "galleries.delete",
      "method": "DELETE",
      "path": "/api/v1/workspaces/{workspace_id}/galleries/{gallery_id}",
      "auth": "user_jwt",
      "rateLimit": "standard",
      "response": {
        "body": {
          "message": "string"
        }
      },
      "errors": [
        "FORBIDDEN",
        "NOT_FOUND"
      ],
      "implementationStatus": "implemented",
      "notes": "Soft delete - sets status to archived"
    },
    {
      "id": "galleries.publish",
      "method": "POST",
      "path": "/api/v1/workspaces/{workspace_id}/galleries/{gallery_id}/publish",
      "auth": "user_jwt",
      "rateLimit": "standard",
      "request": {
        "body": {
          "publish": "boolean"
        }
      },
      "response": {
        "body": {
          "gallery_id": "uuid",
          "status": "enum",
          "published_at": "timestamp?"
        }
      },
      "errors": [
        "FORBIDDEN",
        "GALLERY_EMPTY",
        "NOT_FOUND"
      ],
      "implementationStatus": "implemented"
    },
    {
      "id": "portal.gallery.view",
      "method": "GET",
      "path": "/v1/portal/galleries/{gallery_id}",
      "auth": "share_link_or_user_jwt",
      "rateLimit": "public-standard",
      "response": {
        "body": {
          "gallery": {
            "gallery_id": "uuid",
            "title": "string",
            "branding": "object"
          },
          "policy": "object",
          "assets": "paginated list with cdn urls"
        }
      },
      "errors": [
        "NOT_FOUND",
        "SHARE_LINK_EXPIRED",
        "SHARE_LINK_PASSWORD_REQUIRED"
      ]
    },
    {
      "id": "portal.asset.favorite",
      "method": "POST",
      "path": "/v1/portal/galleries/{gallery_id}/assets/{asset_id}/favorite",
      "auth": "share_link_or_user_jwt",
      "rateLimit": "public-standard",
      "request": {
        "body": {
          "favorite": true
        }
      },
      "response": {
        "body": {
          "ok": true
        }
      },
      "errors": [
        "FORBIDDEN",
        "POLICY_ACTION_NOT_ALLOWED"
      ]
    },
    {
      "id": "portal.asset.unlock",
      "method": "POST",
      "path": "/v1/portal/galleries/{gallery_id}/assets/{asset_id}/unlock",
      "auth": "share_link_or_user_jwt",
      "rateLimit": "public-strict",
      "request": {
        "body": {
          "access_code": "string"
        }
      },
      "response": {
        "body": {
          "unlocked": true
        }
      },
      "errors": [
        "ASSET_LOCKED",
        "ACCESS_CODE_INVALID",
        "POLICY_ACTION_NOT_ALLOWED"
      ]
    },
    {
      "id": "recycle_bin.list",
      "method": "GET",
      "path": "/api/v1/workspaces/{workspace_id}/recycle-bin",
      "auth": "user_jwt",
      "rateLimit": "standard",
      "request": {
        "query": {
          "type": "string?",
          "page": "integer?",
          "limit": "integer?"
        }
      },
      "response": {
        "body": {
          "items": "array",
          "meta": {
            "total": "integer",
            "page": "integer",
            "limit": "integer"
          }
        },
        "item_schema": {
          "id": "uuid",
          "type": "enum(gallery,photo)",
          "name": "string",
          "deletedAt": "timestamp",
          "daysUntilPermanentDelete": "integer",
          "deleted": "boolean",
          "deleteStatus": "string?"
        }
      },
      "errors": [
        "FORBIDDEN"
      ],
      "implementationStatus": "implemented"
    },
    {
      "id": "recycle_bin.restore",
      "method": "POST",
      "path": "/api/v1/workspaces/{workspace_id}/recycle-bin/restore",
      "auth": "user_jwt",
      "rateLimit": "standard",
      "request": {
        "body": {
          "item_id": "uuid",
          "item_type": "enum(gallery,photo)",
          "new_name": "string?"
        }
      },
      "response": {
        "body": {
          "success": "boolean",
          "entity_id": "uuid",
          "new_name": "string?"
        }
      },
      "errors": [
        "FORBIDDEN",
        "NOT_FOUND",
        "NAME_CONFLICT"
      ],
      "implementationStatus": "implemented"
    },
    {
      "id": "recycle_bin.permanent_delete",
      "method": "DELETE",
      "path": "/api/v1/workspaces/{workspace_id}/recycle-bin/permanent",
      "auth": "user_jwt",
      "rateLimit": "sensitive-action",
      "request": {
        "body": {
          "item_id": "uuid",
          "item_type": "enum(gallery,photo)"
        }
      },
      "response": {
        "body": {
          "success": "boolean",
          "files_deleted": "integer",
          "storage_freed": "integer"
        }
      },
      "errors": [
        "FORBIDDEN",
        "NOT_FOUND",
        "CONFLICT"
      ],
      "implementationStatus": "implemented"
    }
  ],
  "workflows": [
    {
      "id": "wf.gallery.publish_share",
      "name": "Publish Gallery + Share",
      "steps": [
        "Staff creates gallery, adds assets, sets portal options (language, branding, watermark/download).",
        "Publish gallery to make it accessible via share links.",
        "Create one or more share links with policies (expiry, password, allowed actions).",
        "Client opens link and browses assets via CDN URLs.",
        "Client actions (favorite/select/comment/download) are recorded for staff review."
      ]
    }
  ],
  "observability": {
    "metrics": [
      "portal_page_views_total{gallery_id}",
      "portal_unique_visitors_total{gallery_id}",
      "client_interactions_total{type}",
      "gallery_publish_total"
    ],
    "logs": [
      "Portal access decisions (share_link_id, gallery_id)",
      "Download attempts and policy denials"
    ],
    "traces": [
      "Portal page load tracing including DB + cache reads"
    ],
    "alerts": [
      "Abnormally high portal 4xx/5xx rates",
      "Unusual download volume (potential abuse)"
    ]
  },
  "security": {
    "controls": [
      "Share-link policy enforcement for each action",
      "Optional password gate and expiry",
      "Signed/CDN URLs for asset delivery; no public bucket access",
      "Rate limiting and abuse detection for public portal endpoints",
      "Per-asset access codes are hashed and brute-force protected"
    ],
    "privacy": [
      "Client interaction data minimization; optional anonymous mode"
    ]
  },
  "i18n": {
    "supportedLanguages": [
      "en-IN",
      "hi-IN",
      "bn-IN",
      "te-IN",
      "mr-IN",
      "ta-IN",
      "gu-IN",
      "kn-IN",
      "ml-IN",
      "pa-IN",
      "ur-IN"
    ],
    "rtl": [
      "ur-IN"
    ],
    "resolutionOrder": [
      "share_link.language (if set)",
      "gallery.portal_language (if set)",
      "workspace.default_language",
      "browser Accept-Language"
    ]
  },
  "performance": {
    "targets": {
      "portal_gallery_p95": "< 700ms (excluding CDN image fetch)",
      "asset_list_50_p95": "< 300ms"
    },
    "cdn": {
      "provider": "cloudflare_cdn",
      "cache": "Aggressive caching for derivatives; signed URLs or tokenized paths for protected content"
    }
  },
  "acceptanceTests": [
    "Publishing a gallery makes it visible through a share link; unpublishing blocks portal access.",
    "Portal language switches based on per-link or per-gallery settings; Urdu displays RTL correctly.",
    "Client favorites and comments show up for staff within the gallery dashboard.",
    "Clients cannot download originals if policy forbids it; they can download watermarked variant if allowed.",
    "Locked/private photos do not reveal content until correct access code is provided."
  ],
  "dependencies": [
    "share_links_access",
    "downloads_watermarking",
    "proofing_selections_comments",
    "i18n_localization",
    "media_processing"
  ],
  "openQuestions": [
    "Do we require clients to enter a name/email before interacting (favorites/comments), or allow fully anonymous interactions?",
    "Do we support per-gallery custom domain mapping (CNAME) as enterprise feature?"
  ],
  "implementationStatus": {
    "backend": {
      "status": "partial",
      "completed": [
        "Database migration (galleries, sub_galleries, gallery_assets, client_interactions tables)",
        "Gallery CRUD API endpoints (list, create, get, update, delete, publish)",
        "Gallery service with workspace scoping",
        "API schemas and validation"
      ],
      "pending": [
        "Sub-gallery endpoints (currently return 501)",
        "Asset listing endpoints",
        "Upload session endpoints",
        "Password hashing (bcrypt implementation)",
        "Client portal endpoints"
      ]
    },
    "frontend": {
      "status": "partial",
      "components": {
        "completed": [
          {
            "name": "GalleryCard",
            "path": "frontend/src/components/features/gallery/GalleryCard.tsx",
            "features": [
              "Cover image display",
              "Status badge",
              "Photo count",
              "Hover actions"
            ]
          },
