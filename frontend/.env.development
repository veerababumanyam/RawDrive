# API URL - Route through Traefik for proper microservice routing
# Traefik handles routing to backend, gallery-service, upload-service, etc.
# CORS is handled by Traefik middleware (cors-headers-dev)
VITE_API_URL=http://localhost

# Upload Microservice
VITE_FEATURE_UPLOAD_MICROSERVICE=true
VITE_UPLOAD_SERVICE_URL=http://localhost:8008
