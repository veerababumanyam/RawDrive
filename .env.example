R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_URL=
CLODFLARE_STREAMING=
CLOUDFLARE_SUB_DOMAIN=
PHONEPE_CLIENT_ID_PROD=
PHONEPE_CLIENT_ID_TEST=
PHONEPE_CLIENT_SECRET_PROD=
PHONEPE_CLIENT_SECRET_TEST=
PHONEPE_CLIENT_VERSION=
PHONEPE_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MERCHANT_NAME=
STITCH_API_KEY=
FIGMA_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
FRONTEND_URL=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
