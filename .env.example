# ─────────────────────────────────────────────────────────────────────────
# M16 2026-04-10 audit hardening vars (F-005, F-010)
# ─────────────────────────────────────────────────────────────────────────

# APP_ENV controls production fail-closed guards. Set to "production" or
# "prod" on live deployments. Any other value (dev, staging, test, or empty)
# is treated as non-production and allows dev-only relaxations.
APP_ENV=development

# F-005: 32-byte hex-encoded Key Encryption Key (KEK) used to wrap the
# per-row Data Encryption Keys for platform_settings secret rows.
# Generate a random one with:   openssl rand -hex 32
# REQUIRED in production — main.go fatals on missing KEK when APP_ENV is
# "production" or "prod". Optional in dev (legacy plaintext mode).
# The KEK MUST live in your secret manager, NOT in the database it protects.
PLATFORM_SETTINGS_KEK=

# F-010: TLS cert paths for the API server. If both are set the API listens
# via ListenAndServeTLS with TLS 1.3 minimum. If both are empty, main.go
# refuses to start in production unless TRUSTED_PROXY_MODE=true.
TLS_CERT_PATH=
TLS_KEY_PATH=

# F-010: escape hatch for deployments behind an upstream TLS terminator
# (Cloudflare / Caddy / Traefik / ALB). Set to "true" ONLY when an upstream
# proxy reliably terminates TLS — the API will then serve plaintext HTTP
# on its listener without failing. Missing or any value other than "true"
# is treated as "not trusted" and production will fatal if TLS cert paths
# are also missing.
TRUSTED_PROXY_MODE=
