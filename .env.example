# ─────────────────────────────────────────────────────────────────────────
# M16 2026-04-10 audit hardening vars (F-005, F-010)
# ─────────────────────────────────────────────────────────────────────────

# APP_ENV controls production fail-closed guards. Set to "production" or
# "prod" on live deployments. Any other value (dev, staging, test, or empty)
# is treated as non-production and allows dev-only relaxations.
APP_ENV=development

# Core service URLs used by the Go API.
DATABASE_URL=
VALKEY_URL=
NATS_URL=
EVENT_BROKER=inprocess

# F-005: 32-byte hex-encoded Key Encryption Key (KEK) used to wrap the
# per-row Data Encryption Keys for platform_settings secret rows.
# Generate a random one with:   openssl rand -hex 32
# REQUIRED in production — main.go fatals on missing KEK when APP_ENV is
# "production" or "prod". Optional in dev (legacy plaintext mode).
# The KEK MUST live in your secret manager, NOT in the database it protects.
PLATFORM_SETTINGS_KEK=

# F-010: TLS cert paths for the API server. If both are set the API listens
# via ListenAndServeTLS with TLS 1.3 minimum. If both are empty, main.go
# refuses to start in production unless TRUSTED_PROXY_MODE=true.
TLS_CERT_PATH=
TLS_KEY_PATH=

# F-010: escape hatch for deployments behind an upstream TLS terminator
# (Cloudflare / Caddy / Traefik / ALB). Set to "true" ONLY when an upstream
# proxy reliably terminates TLS — the API will then serve plaintext HTTP
# on its listener without failing. Missing or any value other than "true"
# is treated as "not trusted" and production will fatal if TLS cert paths
# are also missing.
TRUSTED_PROXY_MODE=

# ─────────────────────────────────────────────────────────────────────────
# v0.0.47 audit fill-in: vars referenced in the Go code but previously
# undocumented here. A fresh prod clone using only this file would crash
# at boot without these — now captured so operators know what to provision.
# ─────────────────────────────────────────────────────────────────────────

# HTTP listener port. Defaults to 8080 if unset.
PORT=8080

# APP_SECRET is a generic signing secret for non-JWT use (CSRF, cookie MAC,
# etc.). Generate with: openssl rand -hex 32
APP_SECRET=

# JWT signing keys — RSA or Ed25519 private/public PEM files mounted into
# the container. These are REQUIRED; /auth/login cannot mint tokens without
# them. Rotate quarterly.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# Impersonation JWT secret — used by platform admins to issue short-lived
# scoped tokens for support access (separate from user JWT signing keys).
# REQUIRED in production. Generate with: openssl rand -hex 64
JWT_IMPERSONATION_SECRET=

# ENCRYPTION_MASTER_KEY is the base64-encoded master key for at-rest
# encryption of generic sensitive columns (distinct from PLATFORM_SETTINGS_KEK
# which is specific to the platform_settings wrap-key model). Generate with:
# openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# AI_ENCRYPTION_KEY is the per-workspace AI spend tracking encryption key.
# Needed only when AI features (face detection, culling, duplicate detection)
# are enabled in config.
AI_ENCRYPTION_KEY=

# Cloudflare R2 object storage. REQUIRED — RawDrive's hardcode laws forbid
# local disk storage, and STORAGE_DRIVER=local causes a fatal exit. All
# R2_* vars are required.
STORAGE_DRIVER=r2
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_URL=
R2_ACCOUNT_ID=

# TOTP MFA issuer label — appears in authenticator apps alongside the
# user's email. Usually set to "RawDrive" in prod.
MFA_ISSUER_NAME=RawDrive

# Gemini model id for the AI culling + design suggestion pipeline.
# Required only when AI features are enabled. Example: gemini-2.5-flash.
GEMINI_MODEL_ID=

# Dev-only: set DEV_STUB_EMAIL=true to route OTP emails to stdout instead
# of a real SMTP server. Production MUST leave this unset.
DEV_STUB_EMAIL=

# Optional tuning knobs — sensible defaults apply if unset.
# UPLOAD_MAX_BYTES caps the size of any single upload. Default: 500MB.
# UPLOAD_SESSION_TTL_HOURS controls how long an open TUS upload session
# stays resumable. Default: 24h.
# TIER_D_ENFORCE_MODE: 0 = audit-log only, 1 = reject non-compliant
# uploads (M16 F-015). Start at 0 in prod, flip to 1 after a drift window.
UPLOAD_MAX_BYTES=
UPLOAD_SESSION_TTL_HOURS=
TIER_D_ENFORCE_MODE=
