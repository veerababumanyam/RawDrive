{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "noEmit": false
  },
  "include": [
    "src/index.ts",
    "src/invitations.ts",
    "src/gallery.ts",
    "src/gradient.ts",
    "src/common.ts",
    "src/sync.ts",
    "src/collaboration.ts",
    "src/admin.ts",
    "src/calendar.ts",
    "src/analytics.ts",
    "src/cleanup.ts",
    "src/compliance.ts",
    "src/export.ts",
    "src/permissions.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "generated"
  ]
}